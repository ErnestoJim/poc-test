@page "/projects/{ProjectId}"
@using SpecFlow.Web.Services
@inject SpecFlowApiClient Api

<PageTitle>@(project?.Name ?? "Proyecto") · SpecFlow</PageTitle>

<a class="back-link" href="/projects">← Proyectos</a>

@if (loading)
{
    <p class="notice">Cargando proyecto…</p>
}
else if (error is not null)
{
    <div class="notice error" role="alert">
        <p>@error.Message</p>
        @if (error.StatusCode is null)
        {
            <button class="button subtle" @onclick="LoadAsync">Reintentar</button>
        }
        <a class="button subtle" href="/projects">Volver a proyectos</a>
    </div>
}
else if (project is not null)
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Proyecto</p>
            <h1>@project.Name</h1>
            <p class="lead">@(project.Description ?? "Sin descripción")</p>
        </div>
        <a class="button primary" href="@($"/projects/{project.Id}/proposals/new")">Nueva propuesta</a>
    </div>

    <section class="section-block" aria-labelledby="proposals-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Dentro del proyecto</p>
                <h2 id="proposals-title">Propuestas</h2>
            </div>
            @if (proposals is not null)
            {
                <span class="count-pill">@proposals.Count</span>
            }
        </div>
        @if (proposalError is not null)
        {
            <div class="notice error" role="alert">
                <p>@proposalError.Message</p>
                <button class="button subtle" @onclick="LoadAsync">Reintentar</button>
            </div>
        }
        else if (proposals is { Count: 0 })
        {
            <div class="empty-state compact">
                <h3>Aún no hay propuestas</h3>
                <p>Describe la primera idea para este proyecto.</p>
                <a class="button primary" href="@($"/projects/{project.Id}/proposals/new")">Crear propuesta</a>
            </div>
        }
        else if (proposals is not null)
        {
            <div class="entity-list">
                @foreach (var proposal in proposals)
                {
                    <a class="entity-row" href="@($"/projects/{project.Id}/proposals/{proposal.Id}")">
                        <div>
                            <h3>@proposal.Title</h3>
                            <p>@(proposal.Description ?? "Sin descripción")</p>
                        </div>
                        <span class="status @proposal.Status">@DisplayText.ProposalStatus(proposal.Status)</span>
                    </a>
                }
            </div>
        }
    </section>

    <section class="section-block" aria-labelledby="decisions-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Contexto técnico</p>
                <h2 id="decisions-title">Decisiones técnicas</h2>
            </div>
            @if (decisions is not null)
            {
                <span class="count-pill">@decisions.Count</span>
            }
        </div>
        @if (Aviso == "decision-eliminada")
        {
            <p class="notice" role="status">Decisión técnica eliminada.</p>
        }
        @if (decisionError is not null)
        {
            <div class="notice error" role="alert">
                <p>No se pudieron cargar las decisiones técnicas. @decisionError.Message</p>
                <button class="button subtle" @onclick="LoadDecisionsAsync">Reintentar</button>
            </div>
        }
        else if (decisions is { Count: 0 })
        {
            <div class="empty-state compact">
                <h3>Aún no hay decisiones técnicas</h3>
                <p>Registra las decisiones que condicionan cómo se construye este proyecto.</p>
                <a class="button primary" href="@($"/projects/{project.Id}/decisions/new")">Registrar decisión</a>
            </div>
        }
        else if (decisions is not null)
        {
            <div class="entity-list">
                @foreach (var decision in decisions)
                {
                    <a class="entity-row" href="@($"/projects/{project.Id}/decisions/{decision.Id}")">
                        <div>
                            <h3>@decision.Title</h3>
                            <p>@(decision.DecidedAtUtc is { } decidedAt ? $"Decidida el {DisplayText.Date(decidedAt)}" : $"Creada el {DisplayText.Date(decision.CreatedAtUtc)}")</p>
                        </div>
                        <span class="status @decision.Status">@DisplayText.DecisionStatus(decision.Status)</span>
                    </a>
                }
            </div>
            <div class="form-actions section-actions">
                <a class="button subtle" href="@($"/projects/{project.Id}/decisions/new")">Nueva decisión técnica</a>
            </div>
        }
    </section>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [SupplyParameterFromQuery] public string? Aviso { get; set; }

    private ProjectDto? project;
    private List<ProposalDto>? proposals;
    private ApiError? error;
    private ApiError? proposalError;
    private List<TechnicalDecisionDto>? decisions;
    private ApiError? decisionError;
    private bool loading = true;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        project = null;
        proposals = null;
        decisions = null;
        decisionError = null;
        error = null;
        proposalError = null;
        if (!RouteIds.TryParse(ProjectId, out var id))
        {
            error = RouteIds.InvalidProject;
        }
        else
        {
            var projectResult = await Api.GetProjectAsync(id);
            project = projectResult.Value;
            error = projectResult.Error;
            if (project is not null)
            {
                var proposalResult = await Api.ListProposalsAsync(id);
                proposals = proposalResult.Value;
                proposalError = proposalResult.Error;
                await LoadDecisionsAsync();
            }
        }
        loading = false;
    }

    private async Task LoadDecisionsAsync()
    {
        if (project is null) return;
        var result = await Api.ListTechnicalDecisionsAsync(project.Id);
        decisions = result.Value;
        decisionError = result.Error;
    }


}
