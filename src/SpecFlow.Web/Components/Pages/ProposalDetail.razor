@page "/projects/{ProjectId}/proposals/{ProposalId}"
@using SpecFlow.Web.Services
@inject SpecFlowApiClient Api

<PageTitle>@(proposal?.Title ?? "Propuesta") · SpecFlow</PageTitle>

<a class="back-link" href="@($"/projects/{ProjectId}")">← Volver al proyecto</a>

@if (loading)
{
    <p class="notice">Cargando propuesta…</p>
}
else if (error is not null)
{
    <div class="notice error" role="alert">
        <p>@error.Message</p>
        @if (error.StatusCode is null)
        {
            <button class="button subtle" @onclick="LoadAsync">Reintentar</button>
        }
        <a class="button subtle" href="/projects">Volver a proyectos</a>
    </div>
}
else if (proposal is not null)
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Propuesta · <a href="@($"/projects/{ProjectId}")">@project?.Name</a></p>
            <h1>@proposal.Title</h1>
        </div>
        <span class="status large @proposal.Status">@DisplayText.ProposalStatus(proposal.Status)</span>
    </div>

    <StatusNotice Message="@decisionNotice" Error="@(requiresRefresh ? actionError : null)" CanRecover="@(requiresRefresh)" Refreshing="@refreshing" OnRecover="RefreshProposalAsync" RefreshingLabel="Actualizando…" />

    @if (proposal.Status == "pending" && !requiresRefresh)
    {
        <section class="decision-section" aria-label="Decidir propuesta">
            @if (!acceptPromptOpen && !rejectFormOpen)
            {
                <p class="eyebrow">Siguiente paso</p>
                <h2>Decidir esta propuesta</h2>
                <p>La decisión cierra la propuesta y no se puede cambiar después.</p>
                <div class="form-actions">
                    <button class="button primary" @onclick="ShowAcceptPrompt">Aceptar</button>
                    <button class="button subtle" @onclick="ShowRejectForm">Rechazar</button>
                </div>
            }
            else if (acceptPromptOpen)
            {
                <p class="eyebrow">Confirmación</p>
                <h2>¿Aceptar esta propuesta?</h2>
                <p>La propuesta quedará aceptada. Esta acción no crea todavía una especificación.</p>
                @if (actionError is not null)
                {
                    <p class="notice error" role="alert">@actionError.Message</p>
                }
                <div class="form-actions">
                    <button class="button primary" @onclick="AcceptAsync" disabled="@submitting">@(submitting ? "Aceptando…" : "Confirmar aceptación")</button>
                    <button class="button subtle" @onclick="CancelDecision" disabled="@submitting">Cancelar</button>
                </div>
            }
            else if (rejectFormOpen)
            {
                <p class="eyebrow">Motivo de rechazo</p>
                <h2>Rechazar propuesta</h2>
                <form @onsubmit="RejectAsync" @onsubmit:preventDefault>
                    <div class="field">
                        <label for="rejection-reason">Motivo <span class="required">*</span></label>
                        <textarea id="rejection-reason" @bind="rejectionReason" @bind:event="oninput" @bind:after="ClearReasonError" rows="4"
                                  disabled="@submitting"
                                  aria-invalid="@FieldValidation.AriaInvalid(actionError, "reason")"
                                  aria-describedby="@FieldValidation.DescribedBy(actionError, "reason", "rejection-reason")"></textarea>
                        <small id="rejection-reason-hint">Explica la decisión en un máximo de 1.000 caracteres.</small>
                        @if (actionError?.HasField("reason") == true)
                        {
                            <span id="rejection-reason-error" class="field-error">Introduce un motivo de hasta 1.000 caracteres.</span>
                        }
                    </div>
                    @if (actionError is not null && !actionError.HasField("reason"))
                    {
                        <p class="notice error" role="alert">@actionError.Message</p>
                    }
                    <div class="form-actions">
                        <button class="button primary" type="submit" disabled="@submitting">@(submitting ? "Rechazando…" : "Confirmar rechazo")</button>
                        <button class="button subtle" type="button" @onclick="CancelDecision" disabled="@submitting">Cancelar</button>
                    </div>
                </form>
            }
        </section>
    }

    @if (proposal.Status == "accepted")
    {
        <section class="decision-section" aria-label="Especificación de la propuesta">
            <p class="eyebrow">Siguiente paso</p>
            <h2>Especificación</h2>
            <p>Consulta la especificación de esta propuesta o crea una si aún no existe.</p>
            <a class="button primary" href="@($"/projects/{ProjectId}/proposals/{ProposalId}/specification")">Abrir especificación</a>
        </section>
    }

    <div class="detail-grid">
        <section class="detail-card">
            <h2>Descripción</h2>
            <p class="description">@(proposal.Description ?? "Esta propuesta no tiene descripción.")</p>
        </section>
        <aside class="detail-card metadata">
            <h2>Información</h2>
            <dl>
                <dt>Creada</dt>
                <dd>@DisplayText.DateTime(proposal.CreatedAtUtc)</dd>
                @if (proposal.DecidedAtUtc is { } decidedAt)
                {
                    <dt>Decidida</dt>
                    <dd>@DisplayText.DateTime(decidedAt)</dd>
                }
                @if (proposal.RejectionReason is not null)
                {
                    <dt>Motivo de rechazo</dt>
                    <dd>@proposal.RejectionReason</dd>
                }
                @if (proposal.SourceProposalId is { } sourceId)
                {
                    <dt>Continúa a</dt>
                    <dd><a href="@($"/projects/{ProjectId}/proposals/{sourceId}")">Ver propuesta de origen →</a></dd>
                }
            </dl>
        </aside>
    </div>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string ProposalId { get; set; } = "";

    private ProjectDto? project;
    private ProposalDto? proposal;
    private ApiError? error;
    private ApiError? actionError;
    private string? decisionNotice;
    private string? rejectionReason;
    private bool acceptPromptOpen;
    private bool rejectFormOpen;
    private bool submitting;
    private bool refreshing;
    private bool requiresRefresh;
    private bool loading = true;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        project = null;
        proposal = null;
        error = null;
        actionError = null;
        decisionNotice = null;
        rejectionReason = null;
        acceptPromptOpen = false;
        rejectFormOpen = false;
        requiresRefresh = false;
        if (!RouteIds.TryParse(ProjectId, out var projectId) || !RouteIds.TryParse(ProposalId, out var proposalId))
        {
            error = RouteIds.InvalidRoute;
        }
        else
        {
            var projectResult = await Api.GetProjectAsync(projectId);
            project = projectResult.Value;
            error = projectResult.Error;
            if (project is not null)
            {
                var proposalResult = await Api.GetProposalAsync(projectId, proposalId);
                proposal = proposalResult.Value;
                error = proposalResult.Error;
            }
        }
        loading = false;
    }

    private void ShowAcceptPrompt()
    {
        acceptPromptOpen = true;
        rejectFormOpen = false;
        actionError = null;
        decisionNotice = null;
    }

    private void ShowRejectForm()
    {
        rejectFormOpen = true;
        acceptPromptOpen = false;
        actionError = null;
        decisionNotice = null;
    }

    private void CancelDecision()
    {
        acceptPromptOpen = false;
        rejectFormOpen = false;
        rejectionReason = null;
        actionError = null;
        decisionNotice = null;
    }

    private void ClearReasonError()
    {
        if (actionError?.HasField("reason") == true)
        {
            actionError = null;
        }
    }

    private async Task AcceptAsync()
    {
        if (submitting || requiresRefresh || proposal is not { Status: "pending" }) return;
        submitting = true;
        try
        {
            var result = await Api.AcceptProposalAsync(proposal.ProjectId, proposal.Id);
            await HandleDecisionResultAsync(result);
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task RejectAsync()
    {
        if (submitting || requiresRefresh || proposal is not { Status: "pending" }) return;
        submitting = true;
        try
        {
            var result = await Api.RejectProposalAsync(proposal.ProjectId, proposal.Id, rejectionReason);
            await HandleDecisionResultAsync(result);
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task HandleDecisionResultAsync(ApiResult<ProposalDto> result)
    {
        actionError = result.Error;
        if (result.Value is { } updated)
        {
            proposal = updated;
            acceptPromptOpen = false;
            rejectFormOpen = false;
            rejectionReason = null;
            decisionNotice = null;
            return;
        }

        if (result.Error?.StatusCode == 404)
        {
            error = result.Error;
            proposal = null;
            return;
        }

        if (result.Error?.StatusCode == 409)
        {
            requiresRefresh = true;
            decisionNotice = "Otra petición pudo haber decidido esta propuesta. Consultando su estado actual…";
            await RefreshProposalAsync();
            return;
        }

        if (result.Error is not { StatusCode: 400 } validationError || !validationError.HasField("reason"))
        {
            requiresRefresh = true;
            decisionNotice = "No se conoce el resultado de la decisión. Consulta el estado actual antes de intentarlo de nuevo.";
        }
    }

    private async Task RefreshProposalAsync()
    {
        if (refreshing || proposal is null) return;
        refreshing = true;
        try
        {
            var result = await Api.GetProposalAsync(proposal.ProjectId, proposal.Id);
            if (result.Value is { } current)
            {
                proposal = current;
                requiresRefresh = false;
                actionError = null;
                decisionNotice = current.Status == "pending"
                    ? "La propuesta sigue pendiente. Puedes revisar la decisión y volver a intentarlo."
                    : "El detalle muestra ahora la decisión vigente.";
                if (current.Status != "pending")
                {
                    acceptPromptOpen = false;
                    rejectFormOpen = false;
                }
            }
            else if (result.Error?.StatusCode == 404)
            {
                error = result.Error;
                proposal = null;
            }
            else
            {
                actionError = result.Error;
                decisionNotice = "No se pudo comprobar el estado actual de la propuesta.";
                requiresRefresh = true;
            }
        }
        finally
        {
            refreshing = false;
        }
    }

}
