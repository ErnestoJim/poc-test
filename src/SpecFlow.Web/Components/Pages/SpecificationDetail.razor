@page "/projects/{ProjectId}/proposals/{ProposalId}/specification"
@using SpecFlow.Web.Services
@inject SpecFlowApiClient Api

<PageTitle>Especificación · SpecFlow</PageTitle>

<a class="back-link" href="@($"/projects/{ProjectId}/proposals/{ProposalId}")">← Volver a la propuesta</a>

@if (loading)
{
    <p class="notice">Cargando especificación…</p>
}
else if (loadError is not null)
{
    <div class="notice error" role="alert">
        <p>@loadError.Message</p>
        @if (loadError.StatusCode is null)
        {
            <button class="button subtle" @onclick="LoadAsync">Reintentar</button>
        }
        <a class="button subtle" href="/projects">Volver a proyectos</a>
    </div>
    <UnsavedTextBlock Title="Texto local no guardado" Text="@unsavedContent" PageLevel />
}
else if (proposal is not null)
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">@project?.Name · @proposal.Title</p>
            <h1>Especificación</h1>
        </div>
        @if (specification is not null)
        {
            <span class="status large @specification.Status">@DisplayText.SpecificationStatus(specification.Status)</span>
        }
    </div>

    @if (proposal.Status != "accepted")
    {
        <div class="notice" role="status">
            <p>Solo una propuesta aceptada puede tener una especificación.</p>
            <a class="button subtle" href="@($"/projects/{ProjectId}/proposals/{ProposalId}")">Volver a la propuesta</a>
        </div>
    }
    else
    {
        <StatusNotice Message="@statusNotice" Error="@refreshError" CanRecover="@(recovery != RecoveryKind.None)" Refreshing="@refreshing" OnRecover="RefreshStateAsync" />

        <StatusNotice Message="@editNotice" Error="@editRefreshError" CanRecover="@(pendingRecovery is not null)" Refreshing="@refreshing" OnRecover="RecoverEditAsync" />

        <StatusNotice Message="@lifecycleNotice" Error="@lifecycleError" CanRecover="@(pendingTransition is not null)" Refreshing="@refreshing" OnRecover="RecoverTransitionAsync" />

        @if (specification is not null)
        {
            @if (editing && showSavedVersion)
            {
                <section class="detail-card saved-version" aria-label="Versión guardada actual">
                    <h2>Versión guardada actual</h2>
                    <p>Actualizada el @DisplayText.DateTime(specification.UpdatedAtUtc). Tu texto sigue en el editor sin guardar.</p>
                    <pre class="markdown-source">@specification.Content</pre>
                </section>
            }

            <div class="detail-grid">
                @if (editing)
                {
                    <form class="detail-card specification-edit" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <div class="field">
                            <label for="specification-edit-content">Contenido Markdown <span class="required">*</span></label>
                            <textarea id="specification-edit-content" class="markdown-editor" @bind="editContent" @bind:event="oninput"
                                      @bind:after="ClearEditContentError" rows="22" disabled="@EditLocked"
                                      aria-invalid="@FieldValidation.AriaInvalid(editError, "content")"
                                      aria-describedby="@FieldValidation.DescribedBy(editError, "content", "specification-edit-content")"></textarea>
                            <small id="specification-edit-content-hint">Escribe hasta 100.000 caracteres. El texto se guardará tal como lo envíes.</small>
                            @if (editError?.HasField("content") == true)
                            {
                                <span id="specification-edit-content-error" class="field-error">Introduce contenido Markdown válido de hasta 100.000 caracteres.</span>
                            }
                        </div>
                        @if (confirmDiscard)
                        {
                            <DiscardConfirmation OnDiscard="ExitEdit" OnKeep="() => confirmDiscard = false" />
                        }
                        else
                        {
                            <div class="form-actions">
                                <button class="button primary" type="submit" disabled="@(EditLocked || !HasEditChanges)">
                                    @(saving ? "Guardando…" : showSavedVersion ? "Guardar mi versión" : "Guardar cambios")
                                </button>
                                @if (showSavedVersion)
                                {
                                    <button class="button subtle" type="button" @onclick="ExitEdit" disabled="@EditLocked">Descartar mi versión</button>
                                }
                                else
                                {
                                    <button class="button subtle" type="button" @onclick="CancelEdit" disabled="@EditLocked">Cancelar</button>
                                }
                            </div>
                        }
                    </form>
                }
                else
                {
                    <section class="detail-card">
                        <div class="card-heading">
                            <h2>Contenido Markdown</h2>
                            @if (CanEdit)
                            {
                                <button class="button subtle" @onclick="StartEdit">Editar</button>
                            }
                        </div>
                        <pre class="markdown-source">@specification.Content</pre>
                    </section>
                }
                <aside class="detail-card metadata">
                    <h2>Información</h2>
                    <dl>
                        <dt>Creada</dt>
                        <dd>@DisplayText.DateTime(specification.CreatedAtUtc)</dd>
                        <dt>Actualizada</dt>
                        <dd>@DisplayText.DateTime(specification.UpdatedAtUtc)</dd>
                        @if (specification.ApprovedAtUtc is { } approvedAt)
                        {
                            <dt>Aprobada</dt>
                            <dd>@DisplayText.DateTime(approvedAt)</dd>
                        }
                        @if (specification.ImplementedAtUtc is { } implementedAt)
                        {
                            <dt>Implementada</dt>
                            <dd>@DisplayText.DateTime(implementedAt)</dd>
                        }
                        @if (specification.VerifiedAtUtc is { } verifiedAt)
                        {
                            <dt>Verificada</dt>
                            <dd>@DisplayText.DateTime(verifiedAt)</dd>
                        }
                    </dl>
                    @if (AvailableTransition is { } transition)
                    {
                        <div class="lifecycle-actions">
                            @if (confirmingTransition == transition)
                            {
                                <div class="notice" role="alert">
                                    <p>@ConfirmationText(transition)</p>
                                    <div class="form-actions">
                                        <button class="button primary" type="button" @onclick="TransitionAsync" disabled="@transitioning">
                                            @(transitioning ? "Guardando…" : ConfirmLabel(transition))
                                        </button>
                                        <button class="button subtle" type="button" @onclick="() => confirmingTransition = null" disabled="@transitioning">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="button primary" type="button" @onclick="() => ConfirmTransition(transition)" disabled="@(!CanTransition)">
                                    @ActionLabel(transition)
                                </button>
                                @if (!CanTransition && pendingTransition is null)
                                {
                                    <p class="section-hint">Termina la edición en curso para cambiar el estado.</p>
                                }
                            }
                        </div>
                    }
                </aside>
            </div>

            <AcceptanceCriteriaSection ProjectId="proposal.ProjectId" ProposalId="proposal.Id" Specification="specification"
                                       SpecificationEntityTag="@entityTag"
                                       Locked="@(ContentLocked || tasksActive)"
                                       OnActiveChanged="active => criteriaActive = active"
                                       ReloadSpecification="ReloadSpecificationAsync"
                                       OnContextLost="HandleSectionContextLost" />

            <ImplementationTasksSection ProjectId="proposal.ProjectId" ProposalId="proposal.Id" Specification="specification"
                                        SpecificationEntityTag="@entityTag"
                                        Locked="@(ContentLocked || criteriaActive)"
                                        OnActiveChanged="active => tasksActive = active"
                                        ReloadSpecification="ReloadSpecificationAsync"
                                        OnContextLost="HandleSectionContextLost" />
        }
        else if (missingSpecification && recovery == RecoveryKind.None)
        {
            <div class="empty-state compact specification-empty">
                <span class="empty-icon">◇</span>
                <h2>Todavía no hay especificación</h2>
                <p>Escribe el documento que describe esta propuesta aceptada.</p>
            </div>

            <form class="form-card specification-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <div class="field">
                    <label for="specification-content">Contenido Markdown <span class="required">*</span></label>
                    <textarea id="specification-content" class="markdown-editor" @bind="content" @bind:event="oninput"
                              @bind:after="ClearContentError" rows="18" disabled="@saving"
                              aria-invalid="@FieldValidation.AriaInvalid(formError, "content")"
                              aria-describedby="@FieldValidation.DescribedBy(formError, "content", "specification-content")"></textarea>
                    <small id="specification-content-hint">Escribe hasta 100.000 caracteres. El texto se guardará tal como lo envíes.</small>
                    @if (formError?.HasField("content") == true)
                    {
                        <span id="specification-content-error" class="field-error">Introduce contenido Markdown válido de hasta 100.000 caracteres.</span>
                    }
                </div>
                @if (formError is not null && !formError.HasField("content"))
                {
                    <p class="notice error" role="alert">@formError.Message</p>
                }
                <div class="form-actions">
                    <button class="button primary" type="submit" disabled="@saving">@(saving ? "Creando…" : "Crear especificación")</button>
                </div>
            </form>
        }

        <UnsavedTextBlock Title="Texto local del intento" Text="@unsavedContent" Hint="Compáralo con la versión guardada arriba. Puedes copiarlo antes de salir." PageLevel />
    }
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string ProposalId { get; set; } = "";

    private enum RecoveryKind { None, Conflict, Unknown }

    private ProjectDto? project;
    private ProposalDto? proposal;
    private SpecificationDto? specification;
    private ApiError? loadError;
    private ApiError? formError;
    private ApiError? refreshError;
    private string? statusNotice;
    private string? content;
    private string? unsavedContent;
    private RecoveryKind recovery;
    private bool missingSpecification;

    private enum EditRecovery { Stale, NotEditable, Uncertain }

    private string? entityTag;
    private bool editing;
    private bool confirmDiscard;
    private bool showSavedVersion;
    private string? editContent;
    private string? editBaseContent;
    private string? sentContent;
    private string? editNotice;
    private ApiError? editError;
    private ApiError? editRefreshError;
    private EditRecovery? pendingRecovery;

    private bool criteriaActive;
    private bool tasksActive;

    private enum Transition { Approve, MarkImplemented, Verify }

    private Transition? confirmingTransition;
    private Transition? pendingTransition;
    private bool transitioning;
    private string? lifecycleNotice;
    private ApiError? lifecycleError;

    private bool TransitionActive => confirmingTransition is not null || transitioning || pendingTransition is not null;
    private bool CanEdit => specification is { Status: "draft" } && entityTag is not null &&
        !editing && !criteriaActive && !tasksActive && !TransitionActive && pendingRecovery is null && recovery == RecoveryKind.None;
    private bool ContentLocked => editing || saving || refreshing || pendingRecovery is not null || recovery != RecoveryKind.None ||
        TransitionActive;
    private bool CanTransition => entityTag is not null && !ContentLocked && !criteriaActive && !tasksActive;
    private Transition? AvailableTransition => specification?.Status switch
    {
        "draft" => Transition.Approve,
        "approved" => Transition.MarkImplemented,
        "implemented" => Transition.Verify,
        _ => null
    };
    private bool EditLocked => saving || refreshing || pendingRecovery is not null;
    private bool HasEditChanges => !string.Equals(editContent, specification?.Content, StringComparison.Ordinal);
    private bool loading = true;
    private bool saving;
    private bool refreshing;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        project = null;
        proposal = null;
        specification = null;
        loadError = null;
        formError = null;
        refreshError = null;
        statusNotice = null;
        content = null;
        unsavedContent = null;
        recovery = RecoveryKind.None;
        missingSpecification = false;
        entityTag = null;
        ResetEditState();
        ResetLifecycleState();

        if (!RouteIds.TryParse(ProjectId, out var projectId) || !RouteIds.TryParse(ProposalId, out var proposalId))
        {
            loadError = RouteIds.InvalidRoute;
        }
        else
        {
            var projectResult = await Api.GetProjectAsync(projectId);
            project = projectResult.Value;
            loadError = projectResult.Error;
            if (project is not null)
            {
                var proposalResult = await Api.GetProposalAsync(projectId, proposalId);
                proposal = proposalResult.Value;
                loadError = proposalResult.Error;
                if (proposal is { Status: "accepted" })
                {
                    var specificationResult = await Api.GetSpecificationAsync(projectId, proposalId);
                    specification = specificationResult.Value;
                    entityTag = specificationResult.EntityTag;
                    missingSpecification = specificationResult.Error?.StatusCode == 404;
                    loadError = missingSpecification ? null : specificationResult.Error;
                }
            }
        }
        loading = false;
    }

    private void ClearContentError()
    {
        if (formError?.HasField("content") == true)
        {
            formError = null;
        }
    }

    private async Task CreateAsync()
    {
        if (saving || recovery != RecoveryKind.None || !missingSpecification ||
            proposal is not { Status: "accepted" }) return;

        saving = true;
        formError = null;
        try
        {
            var result = await Api.CreateSpecificationAsync(proposal.ProjectId, proposal.Id, content);
            if (result.Value is { } created)
            {
                specification = created;
                entityTag = result.EntityTag;
                missingSpecification = false;
                content = null;
                return;
            }

            if (result.Error?.StatusCode == 400 && result.Error.HasField("content"))
            {
                formError = result.Error;
                return;
            }

            if (result.Error?.StatusCode == 404)
            {
                loadError = result.Error;
                return;
            }

            recovery = result.Error?.StatusCode == 409 ? RecoveryKind.Conflict : RecoveryKind.Unknown;
            statusNotice = recovery == RecoveryKind.Conflict
                ? "Otra petición pudo haber creado esta especificación. Consultando su estado actual…"
                : "No se conoce el resultado de la creación. Consulta el estado actual antes de intentarlo de nuevo.";
            refreshError = result.Error;
            if (recovery == RecoveryKind.Conflict)
            {
                await RefreshStateAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RefreshStateAsync()
    {
        if (refreshing || proposal is null || recovery == RecoveryKind.None) return;
        refreshing = true;
        refreshError = null;
        try
        {
            var projectResult = await Api.GetProjectAsync(proposal.ProjectId);
            if (projectResult.Value is null)
            {
                HandleRefreshError(projectResult.Error);
                return;
            }
            project = projectResult.Value;

            var proposalResult = await Api.GetProposalAsync(proposal.ProjectId, proposal.Id);
            if (proposalResult.Value is not { Status: "accepted" } currentProposal)
            {
                HandleRefreshError(proposalResult.Error);
                if (proposalResult.Value is not null)
                {
                    proposal = proposalResult.Value;
                    recovery = RecoveryKind.None;
                }
                return;
            }
            proposal = currentProposal;

            var specificationResult = await Api.GetSpecificationAsync(proposal.ProjectId, proposal.Id);
            if (specificationResult.Value is { } currentSpecification)
            {
                specification = currentSpecification;
                entityTag = specificationResult.EntityTag;
                missingSpecification = false;
                unsavedContent = content;
                content = null;
                recovery = RecoveryKind.None;
                refreshError = null;
                statusNotice = "La especificación mostrada es la versión guardada en la API.";
            }
            else if (specificationResult.Error?.StatusCode == 404)
            {
                specification = null;
                missingSpecification = true;
                if (recovery == RecoveryKind.Unknown)
                {
                    recovery = RecoveryKind.None;
                    statusNotice = "La especificación aún no existe. Puedes revisar el texto y volver a crearla.";
                }
                else
                {
                    statusNotice = "La creación entró en conflicto, pero no se pudo confirmar una especificación existente. Consulta el estado de nuevo.";
                }
            }
            else
            {
                HandleRefreshError(specificationResult.Error);
            }
        }
        finally
        {
            refreshing = false;
        }
    }

    private void ResetEditState()
    {
        editing = false;
        confirmDiscard = false;
        showSavedVersion = false;
        editContent = null;
        editBaseContent = null;
        sentContent = null;
        editNotice = null;
        editError = null;
        editRefreshError = null;
        pendingRecovery = null;
    }

    private void StartEdit()
    {
        if (!CanEdit) return;
        ResetEditState();
        editing = true;
        editContent = specification!.Content;
        editBaseContent = specification.Content;
    }

    private void CancelEdit()
    {
        if (HasEditChanges)
        {
            confirmDiscard = true;
            return;
        }

        ExitEdit();
    }

    private void ExitEdit() => ResetEditState();

    private void ClearEditContentError()
    {
        confirmDiscard = false;
        if (editError?.HasField("content") == true)
        {
            editError = null;
        }
    }

    private async Task SaveAsync()
    {
        if (!editing || EditLocked || !HasEditChanges || entityTag is null ||
            specification is not { Status: "draft" } || proposal is null) return;

        saving = true;
        editError = null;
        editNotice = null;
        editRefreshError = null;
        sentContent = editContent;
        try
        {
            var result = await Api.UpdateSpecificationAsync(proposal.ProjectId, proposal.Id, editContent, entityTag);
            if (result.Value is { } updated)
            {
                specification = updated;
                entityTag = result.EntityTag;
                ResetEditState();
                editNotice = "Cambios guardados.";
                return;
            }

            if (result.Error is { StatusCode: 400 } validationError && validationError.HasField("content"))
            {
                editError = validationError;
                return;
            }

            if (result.Error?.StatusCode == 404)
            {
                unsavedContent = editContent;
                loadError = result.Error;
                return;
            }

            editRefreshError = result.Error;
            switch (result.Error?.StatusCode)
            {
                case 412:
                    pendingRecovery = EditRecovery.Stale;
                    editNotice = "La especificación cambió desde que empezaste a editar. Consultando la versión actual…";
                    break;
                case 409:
                    pendingRecovery = EditRecovery.NotEditable;
                    editNotice = "La especificación ya no se puede editar. Consultando su estado actual…";
                    break;
                default:
                    pendingRecovery = EditRecovery.Uncertain;
                    editNotice = "No se sabe si el cambio se guardó. Consulta el estado actual antes de intentarlo de nuevo.";
                    break;
            }
        }
        finally
        {
            saving = false;
        }

        if (pendingRecovery is EditRecovery.Stale or EditRecovery.NotEditable)
        {
            await RecoverEditAsync();
        }
    }

    private async Task RecoverEditAsync()
    {
        if (refreshing || pendingRecovery is not { } kind || proposal is null) return;
        refreshing = true;
        try
        {
            var result = await Api.GetSpecificationAsync(proposal.ProjectId, proposal.Id);
            if (result.Value is not { } current)
            {
                if (result.Error?.StatusCode == 404)
                {
                    unsavedContent = editContent;
                    loadError = result.Error;
                    return;
                }

                editRefreshError = result.Error;
                editNotice = "No se pudo comprobar el estado actual de la especificación. Tu texto sigue en el editor.";
                return;
            }

            var localContent = editContent;
            var baseContent = editBaseContent;
            specification = current;
            entityTag = result.EntityTag;
            editRefreshError = null;
            pendingRecovery = null;

            if (kind == EditRecovery.Uncertain && string.Equals(current.Content, sentContent, StringComparison.Ordinal))
            {
                ResetEditState();
                editNotice = "El cambio se guardó correctamente.";
                return;
            }

            if (current.Status != "draft" || entityTag is null)
            {
                ResetEditState();
                unsavedContent = localContent;
                editNotice = "La especificación ya no está en borrador y se muestra en modo de lectura. Tu texto no se guardó.";
                return;
            }

            editing = true;
            showSavedVersion = true;
            editContent = localContent;
            editBaseContent = current.Content;
            var savedContentUnchanged = string.Equals(current.Content, baseContent, StringComparison.Ordinal);
            editNotice = kind == EditRecovery.Uncertain && savedContentUnchanged
                ? "Tu cambio no se guardó. Revisa tu texto y decide si lo guardas."
                : savedContentUnchanged
                ?"Tu cambio no se guardó: el contenido guardado no cambió, pero sí el resto del plan (criterios, tareas o su estado). Revisa y decide si guardas tu versión."
                : "Tu cambio no se guardó: otra persona cambió el contenido. Compara ambas versiones y decide si guardas la tuya.";
        }
        finally
        {
            refreshing = false;
        }
    }

    private void ResetLifecycleState()
    {
        confirmingTransition = null;
        pendingTransition = null;
        transitioning = false;
        lifecycleNotice = null;
        lifecycleError = null;
    }

    private void ConfirmTransition(Transition transition)
    {
        if (!CanTransition || AvailableTransition != transition) return;
        lifecycleNotice = null;
        lifecycleError = null;
        editNotice = null;
        confirmingTransition = transition;
    }

    // The specification ETag covers the whole plan, so If-Match ensures the transition applies to the plan on screen.
    private async Task TransitionAsync()
    {
        if (confirmingTransition is not { } transition || transitioning || entityTag is null || proposal is null) return;
        transitioning = true;
        lifecycleNotice = null;
        lifecycleError = null;
        ApiError? error;
        try
        {
            var result = transition switch
            {
                Transition.Approve => await Api.ApproveSpecificationAsync(proposal.ProjectId, proposal.Id, entityTag),
                Transition.MarkImplemented => await Api.MarkSpecificationImplementedAsync(proposal.ProjectId, proposal.Id, entityTag),
                _ => await Api.VerifySpecificationAsync(proposal.ProjectId, proposal.Id, entityTag)
            };
            confirmingTransition = null;
            if (result.Value is { } updated)
            {
                specification = updated;
                entityTag = result.EntityTag;
                lifecycleNotice = transition switch
                {
                    Transition.Approve => "Especificación aprobada. Ya puedes iniciar sus tareas.",
                    Transition.MarkImplemented => "Especificación marcada como implementada. Ya puedes verificar sus criterios.",
                    _ => "Especificación verificada."
                };
                return;
            }

            error = result.Error;
        }
        finally
        {
            transitioning = false;
        }

        switch (error?.StatusCode)
        {
            case 409:
                await ClassifyTransitionConflictAsync(transition);
                break;
            case 412:
                var current = await ReloadSpecificationAsync();
                if (current.Value is null)
                {
                    HandleLifecycleReloadError(transition, current.Error);
                    return;
                }
                // Any transition also changes the ETag, so a status change made elsewhere arrives as 412.
                lifecycleNotice = StatusChangeText(transition, current.Value) ??
                    "El plan cambió desde que lo revisaste. Revisa el contenido, los criterios y las tareas actuales antes de volver a intentarlo.";
                break;
            case 404:
                loadError = error;
                break;
            case null or >= 500:
                pendingTransition = transition;
                lifecycleNotice = "No se sabe si el cambio de estado se aplicó. Consulta el estado actual antes de intentarlo de nuevo.";
                lifecycleError = error;
                break;
            default:
                pendingTransition = transition;
                lifecycleNotice = "No se pudo cambiar el estado. Consulta el estado actual antes de intentarlo de nuevo.";
                break;
        }
    }

    // A 409 is classified by the current status, not by the Problem Details text.
    private async Task ClassifyTransitionConflictAsync(Transition transition)
    {
        var result = await ReloadSpecificationAsync();
        if (result.Value is not { } current)
        {
            HandleLifecycleReloadError(transition, result.Error);
            return;
        }

        lifecycleNotice = StatusChangeText(transition, current) ?? transition switch
        {
            Transition.Approve => "Todavía no se puede aprobar. Necesita al menos un criterio de aceptación, al menos una tarea y que todos los criterios estén cubiertos por alguna tarea; revisa el resumen de cobertura de las tareas.",
            Transition.MarkImplemented => "Todavía no se puede marcar como implementada. Todas las tareas deben estar completadas.",
            _ => "Todavía no se puede marcar como verificada. Todos los criterios deben cumplir; revisa el resumen de verificación de los criterios."
        };
    }

    // Null while the specification is still in the status the transition starts from.
    private static string? StatusChangeText(Transition transition, SpecificationDto current)
    {
        var (source, target) = Statuses(transition);
        if (current.Status == source) return null;
        return current.Status == target
            ? $"La especificación ya estaba {DisplayText.SpecificationStatusPhrase(target)}. Se muestra su estado actual."
            : $"La especificación cambió de estado y ahora está {DisplayText.SpecificationStatusPhrase(current.Status)}.";
    }

    private async Task RecoverTransitionAsync()
    {
        if (refreshing || pendingTransition is not { } transition) return;
        refreshing = true;
        lifecycleError = null;
        try
        {
            var result = await ReloadSpecificationAsync();
            if (result.Value is not { } current)
            {
                HandleLifecycleReloadError(transition, result.Error);
                return;
            }

            pendingTransition = null;
            var (source, target) = Statuses(transition);
            lifecycleNotice = current.Status == target
                ? "El cambio de estado se aplicó correctamente."
                : current.Status == source
                ? "El cambio de estado no se aplicó. Puedes intentarlo de nuevo."
                : $"La especificación cambió de estado y ahora está {DisplayText.SpecificationStatusPhrase(current.Status)}.";
        }
        finally
        {
            refreshing = false;
        }
    }

    private void HandleLifecycleReloadError(Transition transition, ApiError? error)
    {
        if (error?.StatusCode == 404)
        {
            loadError = error;
            return;
        }

        pendingTransition = transition;
        lifecycleNotice = "No se pudo comprobar el estado actual de la especificación.";
        lifecycleError = error;
    }

    private static (string Source, string Target) Statuses(Transition transition) => transition switch
    {
        Transition.Approve => ("draft", "approved"),
        Transition.MarkImplemented => ("approved", "implemented"),
        _ => ("implemented", "verified")
    };

    private static string ActionLabel(Transition transition) => transition switch
    {
        Transition.Approve => "Aprobar especificación",
        Transition.MarkImplemented => "Marcar como implementada",
        _ => "Marcar como verificada"
    };

    private static string ConfirmLabel(Transition transition) => transition switch
    {
        Transition.Approve => "Confirmar aprobación",
        Transition.MarkImplemented => "Confirmar implementación",
        _ => "Confirmar verificación"
    };

    private static string ConfirmationText(Transition transition) => transition switch
    {
        Transition.Approve => "¿Aprobar la especificación? Después no se podrán modificar su contenido, sus criterios, sus tareas ni sus vínculos.",
        Transition.MarkImplemented => "¿Marcar la especificación como implementada? No se podrá volver al estado aprobado ni cambiar el estado de sus tareas.",
        _ => "¿Marcar la especificación como verificada? Después no se podrán cambiar las verificaciones de sus criterios."
    };

    private async Task<ApiResult<SpecificationDto>> ReloadSpecificationAsync()
    {
        var result = proposal is null
            ? new ApiResult<SpecificationDto>(null, ApiError.Local(null, "La propuesta no está disponible."))
            : await Api.GetSpecificationAsync(proposal.ProjectId, proposal.Id);
        if (result.Value is { } current)
        {
            specification = current;
            entityTag = result.EntityTag;
            StateHasChanged();
        }
        return result;
    }

    private void HandleSectionContextLost(ContextLost lost)
    {
        unsavedContent = lost.LocalText;
        loadError = lost.Error;
    }

    private void HandleRefreshError(ApiError? error)
    {
        refreshError = error;
        statusNotice = "No se pudo comprobar el estado actual de la especificación.";
        if (error?.StatusCode == 404)
        {
            loadError = error;
        }
    }



}
