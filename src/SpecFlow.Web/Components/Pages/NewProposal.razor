@page "/projects/{ProjectId}/proposals/new"
@using SpecFlow.Web.Services
@inject SpecFlowApiClient Api
@inject NavigationManager Navigation

<PageTitle>Nueva propuesta · SpecFlow</PageTitle>

<div class="narrow-page">
    <a class="back-link" href="@($"/projects/{ProjectId}")">← Volver al proyecto</a>
    @if (loading)
    {
        <p class="notice">Cargando proyecto…</p>
    }
    else if (projectError is not null)
    {
        <div class="notice error" role="alert">
            <p>@projectError.Message</p>
            @if (projectError.StatusCode is null)
            {
                <button class="button subtle" @onclick="LoadProjectAsync">Reintentar</button>
            }
            <a class="button subtle" href="/projects">Volver a proyectos</a>
        </div>
    }
    else if (project is not null)
    {
        <p class="eyebrow">@project.Name</p>
        <h1>Nueva propuesta</h1>
        <p class="lead">Describe qué te gustaría desarrollar en este proyecto.</p>

        <form class="form-card" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="proposal-title">Título <span class="required">*</span></label>
                <input id="proposal-title" @bind="title" @bind:event="oninput"
                       aria-invalid="@FieldValidation.AriaInvalid(error, "title")"
                       aria-describedby="@FieldValidation.DescribedBy(error, "title", "proposal-title")" />
                <small id="proposal-title-hint">Entre 1 y 200 caracteres.</small>
                @if (error?.HasField("title") == true)
                {
                    <span id="proposal-title-error" class="field-error">Introduce un título válido de hasta 200 caracteres.</span>
                }
            </div>
            <div class="field">
                <label for="proposal-description">Descripción <span class="optional">opcional</span></label>
                <textarea id="proposal-description" @bind="description" @bind:event="oninput" rows="6"
                          aria-invalid="@FieldValidation.AriaInvalid(error, "description")"
                          aria-describedby="@FieldValidation.DescribedBy(error, "description", "proposal-description")"></textarea>
                <small id="proposal-description-hint">Hasta 4.000 caracteres.</small>
                @if (error?.HasField("description") == true)
                {
                    <span id="proposal-description-error" class="field-error">La descripción no puede superar 4.000 caracteres.</span>
                }
            </div>
            @if (error is not null)
            {
                <div class="notice error" role="alert">
                    <p>@error.Message</p>
                    @if (error.StatusCode == 404)
                    {
                        <a href="/projects">Volver a proyectos</a>
                    }
                </div>
            }
            <div class="form-actions">
                <button class="button primary" type="submit" disabled="@saving">@(saving ? "Creando…" : "Crear propuesta")</button>
                <a class="button subtle" href="@($"/projects/{ProjectId}")">Cancelar</a>
            </div>
        </form>
    }
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private ProjectDto? project;
    private ApiError? projectError;
    private ApiError? error;
    private string? title;
    private string? description;
    private bool loading = true;
    private bool saving;

    protected override Task OnParametersSetAsync() => LoadProjectAsync();

    private async Task LoadProjectAsync()
    {
        loading = true;
        projectError = null;
        if (!Guid.TryParse(ProjectId, out var id) || id == Guid.Empty)
        {
            projectError = new ApiError(400, "El identificador del proyecto no es válido.", new HashSet<string>());
        }
        else
        {
            var result = await Api.GetProjectAsync(id);
            project = result.Value;
            projectError = result.Error;
        }
        loading = false;
    }

    private async Task SubmitAsync()
    {
        if (saving || project is null) return;
        saving = true;
        error = null;
        try
        {
            var result = await Api.CreateProposalAsync(project.Id, title, description);
            if (result.Value is { } proposal)
            {
                Navigation.NavigateTo($"/projects/{project.Id}/proposals/{proposal.Id}");
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            saving = false;
        }
    }
}
