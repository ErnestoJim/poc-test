@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/projects"><span class="brand-mark">S</span><span>SpecFlow</span></a>
            <nav aria-label="Navegación principal">
                <a href="/projects">Proyectos</a>
            </nav>
            <span class="header-caption">Del planteamiento a la entrega</span>
        </div>
    </header>
    <main class="main-content">
        @Body
    </main>
    <footer class="site-footer">SpecFlow · Desarrollo guiado por especificaciones</footer>
