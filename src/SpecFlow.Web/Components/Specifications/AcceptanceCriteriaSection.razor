@using SpecFlow.Web.Services
@inject SpecFlowApiClient Api

<section class="section-block criteria-section" aria-labelledby="criteria-heading">
    <div class="section-heading">
        <h2 id="criteria-heading">Criterios de aceptación</h2>
        @if (criteria is not null)
        {
            <span class="count-pill">@criteria.Count</span>
        }
    </div>

    @if (notice is not null)
    {
        <div class="notice decision-notice" role="alert">
            <p>@notice</p>
            @if (noticeError is not null)
            {
                <p>@noticeError.Message</p>
            }
            @if (pending is not null)
            {
                <button class="button subtle" @onclick="RecoverAsync" disabled="@refreshing">
                    @(refreshing ? "Consultando…" : "Consultar estado actual")
                </button>
            }
        </div>
    }

    @if (Specification.Status == "draft" && Locked)
    {
        <p class="section-hint">Termina la edición en curso para modificar los criterios.</p>
    }
    else if (Specification.Status == "implemented" && Locked)
    {
        <p class="section-hint">Termina la edición en curso para registrar verificaciones.</p>
    }

    @if (verificationError is not null && criteria is { Count: > 0 })
    {
        <div class="notice error" role="alert">
            <p>No se pudo consultar la verificación de los criterios. @verificationError.Message</p>
            <button class="button subtle" @onclick="LoadVerificationsAsync" disabled="@loadingVerifications">Reintentar</button>
        </div>
    }
    else if (Specification.Status == "implemented" && criteria is { Count: > 0 } && verifications is not null)
    {
        <p class="coverage-summary @(PendingNumbers.Count == 0 ? "covered" : "uncovered")">@VerificationSummary</p>
    }

    @if (loadingList)
    {
        <p class="notice">Cargando criterios…</p>
    }
    else if (listError is not null)
    {
        <div class="notice error" role="alert">
            <p>No se pudieron cargar los criterios. @listError.Message</p>
            <button class="button subtle" @onclick="LoadListAsync">Reintentar</button>
        </div>
    }
    else if (criteria is { Count: 0 })
    {
        <div class="empty-state compact criteria-empty">
            <h3>Todavía no hay criterios</h3>
            <p>Una especificación necesita al menos un criterio de aceptación antes de aprobarse.</p>
        </div>
    }
    else if (criteria is not null)
    {
        <ol class="criteria-list">
            @for (var index = 0; index < criteria.Count; index++)
            {
                var criterion = criteria[index];
                var position = index;
                <li class="criterion-row" @key="criterion.Id">
                    <span class="criterion-number" aria-hidden="true">@(position + 1)</span>
                    <div class="criterion-body">
                        @if (editingId == criterion.Id)
                        {
                            @if (savedVersion is not null)
                            {
                                <div class="saved-version criterion-saved-version">
                                    <p><strong>Versión guardada actual</strong>. Tu texto sigue en el campo sin guardar.</p>
                                    <p class="criterion-content">@savedVersion</p>
                                </div>
                            }
                            <form @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                <div class="field">
                                    <label for="criterion-edit-content">Criterio @(position + 1) <span class="required">*</span></label>
                                    <textarea id="criterion-edit-content" @bind="editContent" @bind:event="oninput" @bind:after="ClearEditError"
                                              rows="4" disabled="@Busy"
                                              aria-invalid="@FieldValidation.AriaInvalid(editError, "content")"
                                              aria-describedby="@FieldValidation.DescribedBy(editError, "content", "criterion-edit-content")"></textarea>
                                    <small id="criterion-edit-content-hint">Escribe hasta 10.000 caracteres. El texto se guardará tal como lo envíes.</small>
                                    @if (editError?.HasField("content") == true)
                                    {
                                        <span id="criterion-edit-content-error" class="field-error">@FieldMessage(editError)</span>
                                    }
                                </div>
                                @if (confirmDiscard)
                                {
                                    <div class="notice" role="alert">
                                        <p>¿Descartar los cambios sin guardar?</p>
                                        <div class="form-actions">
                                            <button class="button primary" type="button" @onclick="DiscardEdit">Descartar cambios</button>
                                            <button class="button subtle" type="button" @onclick="() => confirmDiscard = false">Seguir editando</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-actions">
                                        <button class="button primary" type="submit" disabled="@(Busy || !HasEditChanges)">
                                            @(sending ? "Guardando…" : savedVersion is not null ? "Guardar mi versión" : "Guardar")
                                        </button>
                                        @if (savedVersion is not null)
                                        {
                                            <button class="button subtle" type="button" @onclick="DiscardEdit" disabled="@Busy">Descartar mi versión</button>
                                        }
                                        else
                                        {
                                            <button class="button subtle" type="button" @onclick="CancelEdit" disabled="@Busy">Cancelar</button>
                                        }
                                    </div>
                                }
                            </form>
                        }
                        else
                        {
                            <p class="criterion-content">@criterion.Content</p>
                            @if (VerificationOf(criterion.Id) is { } verification)
                            {
                                <div class="criterion-verification">
                                    <span class="status @verification.Status">@VerificationLabel(verification.Status)</span>
                                    @if (verification.CheckedAtUtc is { } checkedAt)
                                    {
                                        <span class="task-dates">Comprobado el @FormatDate(checkedAt)</span>
                                    }
                                </div>
                                @if (verification.Evidence is not null)
                                {
                                    <p class="criterion-content verification-evidence">@verification.Evidence</p>
                                }
                            }

                            @if (verifyingId == criterion.Id)
                            {
                                <form class="criterion-form task-links" @onsubmit="SaveVerificationAsync" @onsubmit:preventDefault>
                                    @if (verificationSavedVersion is not null)
                                    {
                                        <div class="saved-version criterion-saved-version">
                                            <p><strong>Verificación guardada actual</strong>: @VerificationLabel(verificationSavedVersion.Status). Tu verificación sigue en el formulario sin guardar.</p>
                                            @if (verificationSavedVersion.Evidence is not null)
                                            {
                                                <p class="criterion-content">@verificationSavedVersion.Evidence</p>
                                            }
                                        </div>
                                    }
                                    <fieldset disabled="@VerificationLocked">
                                        <legend>Resultado del criterio @(position + 1)</legend>
                                        @foreach (var option in VerificationOptions)
                                        {
                                            var value = option;
                                            <label class="verification-option">
                                                <input type="radio" name="criterion-verification-status" value="@value"
                                                       checked="@(verifyStatus == value)" @onchange="() => SelectVerificationStatus(value)" />
                                                <span>@VerificationLabel(value)</span>
                                            </label>
                                        }
                                    </fieldset>
                                    <div class="field">
                                        <label for="criterion-verification-evidence">Evidencia <span class="optional">(opcional)</span></label>
                                        <textarea id="criterion-verification-evidence" @bind="verifyEvidence" @bind:event="oninput" @bind:after="ClearVerificationError"
                                                  rows="4" disabled="@(VerificationLocked || verifyStatus == "unverified")"
                                                  aria-invalid="@FieldValidation.AriaInvalid(verificationFormError, "evidence")"
                                                  aria-describedby="@FieldValidation.DescribedBy(verificationFormError, "evidence", "criterion-verification-evidence")"></textarea>
                                        <small id="criterion-verification-evidence-hint">@(verifyStatus == "unverified" && !string.IsNullOrEmpty(verifyEvidence)
                                            ? "«Sin verificar» no admite evidencia: el texto escrito no se guardará."
                                            : "Hasta 10.000 caracteres. Déjala vacía si no necesitas evidencia.")</small>
                                        @if (verificationFormError?.HasField("evidence") == true)
                                        {
                                            <span id="criterion-verification-evidence-error" class="field-error">Escribe una evidencia con contenido de hasta 10.000 caracteres o déjala vacía.</span>
                                        }
                                    </div>
                                    @if (confirmDiscard)
                                    {
                                        <div class="notice" role="alert">
                                            <p>¿Descartar la verificación sin guardar?</p>
                                            <div class="form-actions">
                                                <button class="button primary" type="button" @onclick="DiscardVerification">Descartar cambios</button>
                                                <button class="button subtle" type="button" @onclick="() => confirmDiscard = false">Seguir editando</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-actions">
                                            <button class="button primary" type="submit" disabled="@(VerificationLocked || !HasVerificationChanges)">
                                                @(sending ? "Guardando…" : verificationSavedVersion is not null ? "Guardar mi verificación" : "Guardar verificación")
                                            </button>
                                            @if (verificationSavedVersion is not null)
                                            {
                                                <button class="button subtle" type="button" @onclick="DiscardVerification" disabled="@VerificationLocked">Descartar mi verificación</button>
                                            }
                                            else
                                            {
                                                <button class="button subtle" type="button" @onclick="CancelVerification" disabled="@VerificationLocked">Cancelar</button>
                                            }
                                        </div>
                                    }
                                </form>
                            }
                            else if (Verifiable)
                            {
                                <div class="criterion-actions">
                                    <button class="button subtle small" type="button" @onclick="() => StartVerificationAsync(criterion.Id)"
                                            disabled="@(ActionsLocked || verifications is null)"
                                            aria-label="@($"Registrar verificación del criterio {position + 1}")">Registrar verificación</button>
                                </div>
                            }
                            else if (confirmDeleteId == criterion.Id)
                            {
                                <div class="notice" role="alert">
                                    <p>¿Eliminar este criterio? También se eliminarán sus vínculos con tareas, si los tiene.</p>
                                    <div class="form-actions">
                                        <button class="button primary" type="button" @onclick="DeleteAsync" disabled="@Busy">
                                            @(sending ? "Eliminando…" : "Eliminar criterio")
                                        </button>
                                        <button class="button subtle" type="button" @onclick="() => confirmDeleteId = null" disabled="@Busy">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else if (Editable)
                            {
                                <div class="criterion-actions">
                                    <button class="button subtle small" type="button" @onclick="() => MoveAsync(position, -1)"
                                            disabled="@(ActionsLocked || position == 0)" aria-label="@($"Subir criterio {position + 1}")">Subir</button>
                                    <button class="button subtle small" type="button" @onclick="() => MoveAsync(position, 1)"
                                            disabled="@(ActionsLocked || position == criteria.Count - 1)" aria-label="@($"Bajar criterio {position + 1}")">Bajar</button>
                                    <button class="button subtle small" type="button" @onclick="() => StartEditAsync(criterion)"
                                            disabled="@(ActionsLocked || !string.IsNullOrEmpty(newContent))" aria-label="@($"Editar criterio {position + 1}")">Editar</button>
                                    <button class="button subtle small" type="button" @onclick="() => ConfirmDelete(criterion.Id)"
                                            disabled="@ActionsLocked" aria-label="@($"Eliminar criterio {position + 1}")">Eliminar</button>
                                </div>
                            }
                        }
                    </div>
                </li>
            }
        </ol>
    }

    @if (Specification.Status == "draft" && !Locked && criteria is not null)
    {
        <form class="form-card criterion-form" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="criterion-new-content">Nuevo criterio <span class="required">*</span></label>
                <textarea id="criterion-new-content" @bind="newContent" @bind:event="oninput" @bind:after="ClearAddError"
                          rows="3" disabled="@AddLocked"
                          aria-invalid="@FieldValidation.AriaInvalid(addError, "content")"
                          aria-describedby="@FieldValidation.DescribedBy(addError, "content", "criterion-new-content")"></textarea>
                <small id="criterion-new-content-hint">Describe un resultado verificable en un máximo de 10.000 caracteres.</small>
                @if (addError?.HasField("content") == true)
                {
                    <span id="criterion-new-content-error" class="field-error">@FieldMessage(addError)</span>
                }
            </div>
            <div class="form-actions">
                <button class="button primary" type="submit" disabled="@AddLocked">
                    @(sending && pendingOperation == Operation.Add ? "Añadiendo…" : "Añadir criterio")
                </button>
            </div>
        </form>
    }

    @if (unsavedText is not null)
    {
        <section class="detail-card unsaved-content" aria-label="Texto de criterio no guardado">
            <h3>Texto de criterio no guardado</h3>
            <p>No se pudo guardar. Puedes copiarlo antes de salir.</p>
            <p class="criterion-content">@unsavedText</p>
        </section>
    }

    @if (unsavedVerification is not null)
    {
        <section class="detail-card unsaved-content" aria-label="Verificación no guardada">
            <h3>Verificación no guardada</h3>
            <p>No se pudo guardar. Puedes copiarla antes de salir.</p>
            <p class="criterion-content">@unsavedVerification</p>
        </section>
    }
</section>

@code {
    public sealed record ContextLost(ApiError Error, string? LocalText);

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid ProposalId { get; set; }
    [Parameter, EditorRequired] public SpecificationDto Specification { get; set; } = default!;

    // Changes whenever anything in the plan changes, so the list is re-read after outside changes.
    [Parameter] public string? SpecificationEntityTag { get; set; }

    // True while another part of the page has an edit, a request or a recovery in progress.
    [Parameter] public bool Locked { get; set; }
    [Parameter] public EventCallback<bool> OnActiveChanged { get; set; }
    [Parameter, EditorRequired] public Func<Task<ApiResult<SpecificationDto>>> ReloadSpecification { get; set; } = default!;
    [Parameter] public EventCallback<ContextLost> OnContextLost { get; set; }

    private enum Operation { Add, Edit, Delete, Reorder, Verify }

    private static readonly string[] VerificationOptions = ["unverified", "passed", "failed"];

    private Guid? loadedFor;
    private List<AcceptanceCriterionDto>? criteria;
    private string? listEntityTag;
    private ApiError? listError;
    private bool loadingList;
    private string? listLoadedForTag;

    private Dictionary<Guid, AcceptanceCriterionVerificationDto>? verifications;
    private ApiError? verificationError;
    private bool loadingVerifications;
    private int verificationsVersion;

    private Guid? verifyingId;
    private string verifyStatus = "unverified";
    private string? verifyEvidence;
    private string? verifyEntityTag;
    private AcceptanceCriterionVerificationDto? verificationBaseline;
    private AcceptanceCriterionVerificationDto? verificationSavedVersion;
    private AcceptanceCriterionVerificationDto? sentVerification;
    private ApiError? verificationFormError;
    private string? unsavedVerification;

    private string? newContent;
    private ApiError? addError;

    private Guid? editingId;
    private string? editContent;
    private string? editEntityTag;
    private string? savedVersion;
    private ApiError? editError;
    private bool confirmDiscard;

    private Guid? confirmDeleteId;

    private bool sending;
    private bool refreshing;
    private Operation? pending;
    private Operation? pendingOperation;
    private string? sentContent;
    private Guid? targetId;
    private List<Guid>? requestedOrder;

    private string? notice;
    private ApiError? noticeError;
    private string? unsavedText;
    private bool reportedActive;

    private bool Busy => sending || refreshing;
    private bool Editable => Specification.Status == "draft" && !Locked && pending is null;
    private bool AddLocked => Busy || editingId is not null || pending is not null;
    private bool Verifiable => Specification.Status == "implemented" && !Locked && pending is null;
    private bool ActionsLocked => Busy || editingId is not null || confirmDeleteId is not null || verifyingId is not null;
    // Nothing is resent while the outcome of a verification save is unknown.
    private bool VerificationLocked => Busy || pending is not null;
    private bool HasVerificationChanges => verifyingId is not null && verificationBaseline is not null &&
        (verifyStatus != verificationBaseline.Status ||
         !string.Equals(NormalizeEvidence(verifyStatus, verifyEvidence), verificationBaseline.Evidence, StringComparison.Ordinal));
    private bool HasEditChanges => editingId is { } id &&
        !string.Equals(editContent, criteria?.FirstOrDefault(c => c.Id == id)?.Content ?? savedVersion, StringComparison.Ordinal);
    private bool Active => editingId is not null || confirmDeleteId is not null || verifyingId is not null || Busy ||
        pending is not null || !string.IsNullOrEmpty(newContent);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != Specification.Id)
        {
            loadedFor = Specification.Id;
            await LoadListAsync();
        }
        else if (SpecificationEntityTag != listLoadedForTag && !Busy && !loadingList)
        {
            await LoadListAsync();
        }

        if (Specification.Status != "draft")
        {
            MoveLocalTextToUnsaved();
        }

        if (Specification.Status != "implemented")
        {
            MoveVerificationToUnsaved();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var active = Active;
        if (active != reportedActive)
        {
            reportedActive = active;
            await OnActiveChanged.InvokeAsync(active);
        }
    }

    private async Task LoadListAsync()
    {
        listLoadedForTag = SpecificationEntityTag;
        loadingList = true;
        listError = null;
        try
        {
            var result = await Api.ListAcceptanceCriteriaAsync(ProjectId, ProposalId);
            if (result.Value is { } current)
            {
                criteria = current;
                listEntityTag = result.EntityTag;
            }
            else
            {
                listError = result.Error;
            }
        }
        finally
        {
            loadingList = false;
        }

        if (criteria is not null && listError is null)
        {
            await LoadVerificationsAsync();
        }
    }

    // Verifications only exist once the specification is implemented; earlier every criterion is unverified.
    private async Task LoadVerificationsAsync()
    {
        if (Specification.Status is not ("implemented" or "verified") || criteria is not { } current)
        {
            verifications = null;
            verificationError = null;
            return;
        }

        var version = ++verificationsVersion;
        loadingVerifications = true;
        try
        {
            var results = await Task.WhenAll(current.Select(async criterion =>
                (criterion.Id, Result: await Api.GetAcceptanceCriterionVerificationAsync(ProjectId, ProposalId, criterion.Id))));
            if (version != verificationsVersion) return;

            var failure = results.Select(r => r.Result.Error).FirstOrDefault(e => e is not null);
            if (failure is not null)
            {
                verifications = null;
                verificationError = failure;
                return;
            }

            verifications = results.ToDictionary(r => r.Id, r => r.Result.Value!);
            verificationError = null;
        }
        finally
        {
            if (version == verificationsVersion)
            {
                loadingVerifications = false;
            }
        }
    }

    private async Task StartVerificationAsync(Guid criterionId)
    {
        if (!Verifiable || ActionsLocked || verifications is null) return;
        sending = true;
        ClearNotice();
        try
        {
            var result = await Api.GetAcceptanceCriterionVerificationAsync(ProjectId, ProposalId, criterionId);
            if (result.Value is not { } current || result.EntityTag is null)
            {
                if (result.Error?.StatusCode == 404)
                {
                    await HandleMissingAsync(null);
                    return;
                }

                notice = "No se pudo consultar la verificación del criterio.";
                noticeError = result.Error;
                return;
            }

            verifyingId = criterionId;
            verifyStatus = current.Status;
            verifyEvidence = current.Evidence;
            verifyEntityTag = result.EntityTag;
            verificationBaseline = current;
            verificationSavedVersion = null;
            verificationFormError = null;
            confirmDiscard = false;
            if (!verifications.TryGetValue(criterionId, out var listed) || listed != current)
            {
                verifications[criterionId] = current;
                notice = "La verificación del criterio cambió desde que se cargó la vista. Se muestra la actual.";
            }
        }
        finally
        {
            sending = false;
        }
    }

    private void SelectVerificationStatus(string status)
    {
        verifyStatus = status;
        ClearVerificationError();
    }

    private void ClearVerificationError()
    {
        confirmDiscard = false;
        if (verificationFormError?.HasField("evidence") == true)
        {
            verificationFormError = null;
        }
    }

    private void CancelVerification()
    {
        if (HasVerificationChanges)
        {
            confirmDiscard = true;
            return;
        }

        ExitVerification();
    }

    private void DiscardVerification()
    {
        ExitVerification();
        ClearNotice();
    }

    private void ExitVerification()
    {
        verifyingId = null;
        verifyStatus = "unverified";
        verifyEvidence = null;
        verifyEntityTag = null;
        verificationBaseline = null;
        verificationSavedVersion = null;
        verificationFormError = null;
        confirmDiscard = false;
    }

    private async Task SaveVerificationAsync()
    {
        if (verifyingId is not { } id || verifyEntityTag is null || !Verifiable || VerificationLocked || !HasVerificationChanges) return;
        BeginSend(Operation.Verify, null, id);
        sentVerification = new AcceptanceCriterionVerificationDto(verifyStatus, NormalizeEvidence(verifyStatus, verifyEvidence), null);
        verificationFormError = null;
        try
        {
            var result = await Api.SaveAcceptanceCriterionVerificationAsync(
                ProjectId, ProposalId, id, sentVerification.Status, sentVerification.Evidence, verifyEntityTag);
            if (result.Value is not null)
            {
                ExitVerification();
                await AfterChangeAsync("Verificación guardada.");
                return;
            }

            if (result.Error is { StatusCode: 400 } validation && validation.HasField("evidence"))
            {
                verificationFormError = validation;
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                pending = Operation.Verify;
                notice = "La verificación del criterio cambió desde que empezaste a registrarla. Consultando la actual…";
            }
            else
            {
                await HandleFailureAsync(Operation.Verify, result.Error);
                return;
            }
        }
        finally
        {
            sending = false;
        }

        await RecoverAsync();
    }

    private async Task<string> ResolveVerificationRecoveryAsync(List<AcceptanceCriterionDto> current)
    {
        if (targetId is not { } id || current.All(c => c.Id != id))
        {
            unsavedVerification = VerificationText();
            ExitVerification();
            return "El criterio ya no existe. Tu verificación no se guardó.";
        }

        var fresh = await Api.GetAcceptanceCriterionVerificationAsync(ProjectId, ProposalId, id);
        if (fresh.Value is not { } saved || fresh.EntityTag is null)
        {
            pending = Operation.Verify;
            noticeError = fresh.Error;
            return "No se pudo consultar la verificación actual del criterio. Tu verificación sigue en el formulario.";
        }

        if (sentVerification is not null && SameVerification(saved, sentVerification))
        {
            ExitVerification();
            return "La verificación se guardó correctamente.";
        }

        if (verifyingId != id)
        {
            return "La verificación no se guardó. Revisa el resultado actual del criterio.";
        }

        verifyEntityTag = fresh.EntityTag;
        verificationBaseline = saved;
        if (!HasVerificationChanges)
        {
            ExitVerification();
            return "El criterio ya tiene la verificación que registraste.";
        }

        verificationSavedVersion = saved;
        return "Tu verificación no se guardó. Compárala con la guardada y decide si guardas la tuya.";
    }

    private void ClearAddError()
    {
        if (addError?.HasField("content") == true)
        {
            addError = null;
        }
    }

    private void ClearEditError()
    {
        confirmDiscard = false;
        if (editError?.HasField("content") == true)
        {
            editError = null;
        }
    }

    private async Task AddAsync()
    {
        if (!Editable || AddLocked) return;
        BeginSend(Operation.Add, newContent, null);
        addError = null;
        try
        {
            var result = await Api.CreateAcceptanceCriterionAsync(ProjectId, ProposalId, newContent);
            if (result.Value is not null)
            {
                newContent = null;
                await AfterChangeAsync("Criterio añadido.");
                return;
            }

            if (IsContentValidation(result.Error))
            {
                addError = result.Error;
                return;
            }

            await HandleFailureAsync(Operation.Add, result.Error);
        }
        finally
        {
            sending = false;
        }
    }

    private async Task StartEditAsync(AcceptanceCriterionDto criterion)
    {
        if (!Editable || ActionsLocked) return;
        sending = true;
        ClearNotice();
        try
        {
            var result = await Api.GetAcceptanceCriterionAsync(ProjectId, ProposalId, criterion.Id);
            if (result.Value is not { } current || result.EntityTag is null)
            {
                if (result.Error?.StatusCode == 404)
                {
                    await HandleMissingAsync(null);
                    return;
                }

                notice = "No se pudo abrir el criterio para editarlo.";
                noticeError = result.Error;
                return;
            }

            editingId = current.Id;
            editContent = current.Content;
            editEntityTag = result.EntityTag;
            savedVersion = null;
            editError = null;
            confirmDiscard = false;
            if (!string.Equals(current.Content, criterion.Content, StringComparison.Ordinal))
            {
                ReplaceCriterion(current);
                notice = "El criterio cambió desde que se cargó el listado. Se muestra su versión actual.";
            }
        }
        finally
        {
            sending = false;
        }
    }

    private void CancelEdit()
    {
        if (HasEditChanges)
        {
            confirmDiscard = true;
            return;
        }

        ExitEdit();
    }

    private void DiscardEdit()
    {
        ExitEdit();
        ClearNotice();
    }

    private void ExitEdit()
    {
        editingId = null;
        editContent = null;
        editEntityTag = null;
        savedVersion = null;
        editError = null;
        confirmDiscard = false;
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not { } id || editEntityTag is null || !Editable || Busy || !HasEditChanges) return;
        BeginSend(Operation.Edit, editContent, id);
        editError = null;
        try
        {
            var result = await Api.UpdateAcceptanceCriterionAsync(ProjectId, ProposalId, id, editContent, editEntityTag);
            if (result.Value is not null)
            {
                ExitEdit();
                await AfterChangeAsync("Criterio actualizado.");
                return;
            }

            if (IsContentValidation(result.Error))
            {
                editError = result.Error;
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                pending = Operation.Edit;
                notice = "El criterio cambió desde que empezaste a editarlo. Consultando su versión actual…";
            }
            else
            {
                await HandleFailureAsync(Operation.Edit, result.Error);
                return;
            }
        }
        finally
        {
            sending = false;
        }

        await RecoverAsync();
    }

    private void ConfirmDelete(Guid criterionId)
    {
        if (!Editable || ActionsLocked) return;
        ClearNotice();
        confirmDeleteId = criterionId;
    }

    private async Task DeleteAsync()
    {
        if (confirmDeleteId is not { } id || !Editable || Busy) return;
        var listed = criteria?.FirstOrDefault(c => c.Id == id);
        BeginSend(Operation.Delete, null, id);
        try
        {
            var current = await Api.GetAcceptanceCriterionAsync(ProjectId, ProposalId, id);
            if (current.Value is null || current.EntityTag is null)
            {
                confirmDeleteId = null;
                if (current.Error?.StatusCode == 404)
                {
                    await HandleMissingAsync(null);
                    return;
                }

                notice = "No se pudo comprobar el criterio antes de eliminarlo.";
                noticeError = current.Error;
                return;
            }

            if (!string.Equals(current.Value.Content, listed?.Content, StringComparison.Ordinal))
            {
                confirmDeleteId = null;
                await ReloadAllAsync();
                notice = "El criterio cambió desde que se cargó el listado. Revísalo antes de eliminarlo.";
                return;
            }

            var result = await Api.DeleteAcceptanceCriterionAsync(ProjectId, ProposalId, id, current.EntityTag);
            confirmDeleteId = null;
            if (result.IsSuccess)
            {
                await AfterChangeAsync("Criterio eliminado.");
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                notice = "El criterio cambió antes de eliminarlo. Revisa el listado actual.";
                return;
            }

            await HandleFailureAsync(Operation.Delete, result.Error);
        }
        finally
        {
            sending = false;
        }
    }

    private async Task MoveAsync(int index, int offset)
    {
        var target = index + offset;
        if (!Editable || ActionsLocked || criteria is null || listEntityTag is null ||
            target < 0 || target >= criteria.Count) return;

        var order = criteria.Select(c => c.Id).ToList();
        (order[index], order[target]) = (order[target], order[index]);
        BeginSend(Operation.Reorder, null, null);
        requestedOrder = order;
        try
        {
            var result = await Api.ReorderAcceptanceCriteriaAsync(ProjectId, ProposalId, order, listEntityTag);
            if (result.IsSuccess)
            {
                await AfterChangeAsync(null);
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                notice = "El listado de criterios cambió. Revisa el orden actual antes de moverlos.";
                return;
            }

            await HandleFailureAsync(Operation.Reorder, result.Error);
        }
        finally
        {
            sending = false;
        }
    }

    private void BeginSend(Operation operation, string? content, Guid? criterionId)
    {
        sending = true;
        ClearNotice();
        pendingOperation = operation;
        sentContent = content;
        targetId = criterionId;
        requestedOrder = null;
    }

    // The specification ETag covers the whole plan, so it is refreshed after every criteria change.
    private async Task AfterChangeAsync(string? message)
    {
        var specification = await ReloadSpecification();
        await LoadListAsync();
        notice = message;
        if (specification.Value is null)
        {
            notice = $"{message} No se pudo actualizar la especificación; consúltala de nuevo antes de editar su contenido.".TrimStart();
            noticeError = specification.Error;
        }
    }

    private async Task HandleFailureAsync(Operation operation, ApiError? error)
    {
        switch (error?.StatusCode)
        {
            case 409:
                await ClassifyConflictAsync(operation);
                break;
            case 404:
                await HandleMissingAsync(operation is Operation.Add or Operation.Edit ? sentContent : null);
                break;
            case null or >= 500:
                pending = operation;
                notice = "No se sabe si el cambio se aplicó. Consulta el estado actual antes de intentarlo de nuevo.";
                noticeError = error;
                break;
            default:
                pending = operation;
                notice = "No se pudo completar la operación. Consulta el estado actual antes de intentarlo de nuevo.";
                break;
        }
    }

    private async Task ClassifyConflictAsync(Operation operation)
    {
        var specification = await ReloadSpecification();
        if (specification.Value is not { } current)
        {
            await HandleSpecificationErrorAsync(operation, specification.Error);
            return;
        }

        if (operation == Operation.Verify)
        {
            await LoadListAsync();
            if (current.Status != "implemented")
            {
                MoveVerificationToUnsaved();
                notice = "La especificación ya no está implementada y las verificaciones se muestran en modo de lectura.";
                return;
            }

            pending = Operation.Verify;
            notice = "No se pudo guardar la verificación. Consulta el estado actual antes de intentarlo de nuevo.";
            return;
        }

        if (current.Status != "draft")
        {
            await LoadListAsync();
            MoveLocalTextToUnsaved();
            notice = "La especificación ya no está en borrador y sus criterios se muestran en modo de lectura.";
            return;
        }

        switch (operation)
        {
            case Operation.Add:
                addError = DuplicateError();
                break;
            case Operation.Edit:
                editError = DuplicateError();
                break;
            default:
                await LoadListAsync();
                notice = "El listado de criterios cambió. Revisa el listado actual.";
                break;
        }
    }

    private async Task HandleMissingAsync(string? localText)
    {
        var specification = await ReloadSpecification();
        if (specification.Value is null)
        {
            if (specification.Error?.StatusCode == 404)
            {
                await OnContextLost.InvokeAsync(new ContextLost(specification.Error, localText ?? LocalText() ?? VerificationText()));
                return;
            }

            notice = "No se pudo comprobar el estado actual de la especificación.";
            noticeError = specification.Error;
            return;
        }

        if (editingId is not null)
        {
            unsavedText = editContent;
            ExitEdit();
        }

        if (verifyingId is not null)
        {
            unsavedVerification = VerificationText();
            ExitVerification();
        }

        await LoadListAsync();
        notice = "El criterio ya no existe. Se muestra el listado actual.";
    }

    private async Task HandleSpecificationErrorAsync(Operation operation, ApiError? error)
    {
        if (error?.StatusCode == 404)
        {
            await OnContextLost.InvokeAsync(new ContextLost(error, LocalText() ?? VerificationText()));
            return;
        }

        pending = operation;
        notice = "No se pudo comprobar el estado actual de la especificación.";
        noticeError = error;
    }

    private async Task RecoverAsync()
    {
        if (refreshing || pending is not { } operation) return;
        refreshing = true;
        noticeError = null;
        try
        {
            var specification = await ReloadSpecification();
            if (specification.Value is not { } current)
            {
                await HandleSpecificationErrorAsync(operation, specification.Error);
                return;
            }

            var list = await Api.ListAcceptanceCriteriaAsync(ProjectId, ProposalId);
            if (list.Value is not { } currentCriteria)
            {
                notice = "No se pudo consultar el listado actual de criterios.";
                noticeError = list.Error;
                return;
            }

            criteria = currentCriteria;
            listEntityTag = list.EntityTag;
            listError = null;
            pending = null;
            await LoadVerificationsAsync();
            notice = await ResolveRecoveryAsync(operation, currentCriteria);

            if (operation == Operation.Verify)
            {
                if (current.Status != "implemented")
                {
                    MoveVerificationToUnsaved();
                    notice = $"{notice} La especificación ya no está implementada y las verificaciones se muestran en modo de lectura.";
                }
            }
            else if (current.Status != "draft")
            {
                MoveLocalTextToUnsaved();
                notice = $"{notice} La especificación ya no está en borrador y sus criterios se muestran en modo de lectura.";
            }
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task<string> ResolveRecoveryAsync(Operation operation, List<AcceptanceCriterionDto> current)
    {
        switch (operation)
        {
            case Operation.Add:
                if (current.Any(c => string.Equals(c.Content, sentContent, StringComparison.Ordinal)))
                {
                    if (string.Equals(newContent, sentContent, StringComparison.Ordinal))
                    {
                        newContent = null;
                    }
                    return "El criterio se añadió correctamente.";
                }
                return "El criterio no se añadió. Tu texto sigue en el campo.";

            case Operation.Edit:
                var target = current.FirstOrDefault(c => c.Id == targetId);
                if (target is null)
                {
                    unsavedText = editContent ?? sentContent;
                    ExitEdit();
                    return "El criterio ya no existe. Tu texto no se guardó y se muestra abajo.";
                }

                if (string.Equals(target.Content, editContent, StringComparison.Ordinal))
                {
                    ExitEdit();
                    return "El criterio ya tiene el texto que enviaste.";
                }

                var fresh = await Api.GetAcceptanceCriterionAsync(ProjectId, ProposalId, target.Id);
                if (fresh.Value is null || fresh.EntityTag is null)
                {
                    pending = Operation.Edit;
                    noticeError = fresh.Error;
                    return "No se pudo consultar la versión actual del criterio. Tu texto sigue en el campo.";
                }

                ReplaceCriterion(fresh.Value);
                editingId = target.Id;
                editEntityTag = fresh.EntityTag;
                savedVersion = fresh.Value.Content;
                return "Tu cambio no se guardó. Compara tu texto con la versión guardada y decide si guardas la tuya.";

            case Operation.Verify:
                return await ResolveVerificationRecoveryAsync(current);

            case Operation.Delete:
                return current.Any(c => c.Id == targetId)
                    ? "El criterio no se eliminó. Puedes intentarlo de nuevo."
                    : "El criterio se eliminó correctamente.";

            default:
                return requestedOrder is not null && current.Select(c => c.Id).SequenceEqual(requestedOrder)
                    ? "El nuevo orden se guardó correctamente."
                    : "El orden no cambió. Revisa el listado actual.";
        }
    }

    private async Task ReloadAllAsync()
    {
        await ReloadSpecification();
        await LoadListAsync();
    }

    private void ReplaceCriterion(AcceptanceCriterionDto current)
    {
        var index = criteria?.FindIndex(c => c.Id == current.Id) ?? -1;
        if (index >= 0)
        {
            criteria![index] = current;
        }
    }

    private string? LocalText() =>
        editingId is not null ? editContent : string.IsNullOrEmpty(newContent) ? null : newContent;

    private string? VerificationText()
    {
        if (verifyingId is not { } id) return null;
        var position = criteria?.FindIndex(c => c.Id == id) ?? -1;
        var label = $"Criterio {position + 1}: {VerificationLabel(verifyStatus)}";
        var evidence = NormalizeEvidence(verifyStatus, verifyEvidence);
        return evidence is null ? label : $"{label}\n\n{evidence}";
    }

    private void MoveVerificationToUnsaved()
    {
        if (verifyingId is null) return;
        unsavedVerification = VerificationText();
        ExitVerification();
    }

    private AcceptanceCriterionVerificationDto? VerificationOf(Guid criterionId) =>
        Specification.Status is "implemented" or "verified" && verifications?.TryGetValue(criterionId, out var verification) == true
            ? verification
            : null;

    private List<int> PendingNumbers => criteria is null || verifications is null
        ? []
        : criteria.Select((c, i) => (c.Id, Number: i + 1))
            .Where(c => !verifications.TryGetValue(c.Id, out var v) || v.Status != "passed")
            .Select(c => c.Number)
            .ToList();

    private string VerificationSummary => PendingNumbers switch
    {
        { Count: 0 } => "Todos los criterios cumplen.",
        { Count: 1 } single => $"Criterio pendiente de cumplir: {single[0]}.",
        var many => $"Criterios pendientes de cumplir: {string.Join(", ", many.Take(many.Count - 1))} y {many[^1]}."
    };

    // The API does not accept evidence for an unverified criterion, and an empty field means "no evidence".
    private static string? NormalizeEvidence(string status, string? evidence) =>
        status == "unverified" || string.IsNullOrEmpty(evidence) ? null : evidence;

    private static bool SameVerification(AcceptanceCriterionVerificationDto saved, AcceptanceCriterionVerificationDto sent) =>
        saved.Status == sent.Status && string.Equals(saved.Evidence, sent.Evidence, StringComparison.Ordinal);

    private static string VerificationLabel(string status) => status switch
    {
        "unverified" => "Sin verificar",
        "passed" => "Cumple",
        "failed" => "No cumple",
        _ => "Estado desconocido"
    };

    private static string FormatDate(DateTimeOffset date) => date.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private void MoveLocalTextToUnsaved()
    {
        var local = LocalText();
        if (local is not null)
        {
            unsavedText = local;
        }

        newContent = null;
        addError = null;
        confirmDeleteId = null;
        ExitEdit();
    }

    private void ClearNotice()
    {
        notice = null;
        noticeError = null;
    }

    private static bool IsContentValidation(ApiError? error) =>
        error is { StatusCode: 400 } && error.HasField("content");

    private static ApiError DuplicateError() =>
        new(409, "Ya existe un criterio con ese texto.", new HashSet<string> { "content" });

    private static string FieldMessage(ApiError error) => error.StatusCode == 409
        ? "Ya existe un criterio con ese texto en esta especificación."
        : "Introduce un criterio de hasta 10.000 caracteres.";
}
