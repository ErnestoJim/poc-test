@using SpecFlow.Web.Services
@inject SpecFlowApiClient Api

<section class="section-block criteria-section" aria-labelledby="criteria-heading">
    <div class="section-heading">
        <h2 id="criteria-heading">Criterios de aceptación</h2>
        @if (criteria is not null)
        {
            <span class="count-pill">@criteria.Count</span>
        }
    </div>

    @if (notice is not null)
    {
        <div class="notice decision-notice" role="alert">
            <p>@notice</p>
            @if (noticeError is not null)
            {
                <p>@noticeError.Message</p>
            }
            @if (pending is not null)
            {
                <button class="button subtle" @onclick="RecoverAsync" disabled="@refreshing">
                    @(refreshing ? "Consultando…" : "Consultar estado actual")
                </button>
            }
        </div>
    }

    @if (Specification.Status == "draft" && Locked)
    {
        <p class="section-hint">Termina la edición del contenido para modificar los criterios.</p>
    }

    @if (loadingList)
    {
        <p class="notice">Cargando criterios…</p>
    }
    else if (listError is not null)
    {
        <div class="notice error" role="alert">
            <p>No se pudieron cargar los criterios. @listError.Message</p>
            <button class="button subtle" @onclick="LoadListAsync">Reintentar</button>
        </div>
    }
    else if (criteria is { Count: 0 })
    {
        <div class="empty-state compact criteria-empty">
            <h3>Todavía no hay criterios</h3>
            <p>Una especificación necesita al menos un criterio de aceptación antes de aprobarse.</p>
        </div>
    }
    else if (criteria is not null)
    {
        <ol class="criteria-list">
            @for (var index = 0; index < criteria.Count; index++)
            {
                var criterion = criteria[index];
                var position = index;
                <li class="criterion-row" @key="criterion.Id">
                    <span class="criterion-number" aria-hidden="true">@(position + 1)</span>
                    <div class="criterion-body">
                        @if (editingId == criterion.Id)
                        {
                            @if (savedVersion is not null)
                            {
                                <div class="saved-version criterion-saved-version">
                                    <p><strong>Versión guardada actual</strong>. Tu texto sigue en el campo sin guardar.</p>
                                    <p class="criterion-content">@savedVersion</p>
                                </div>
                            }
                            <form @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                <div class="field">
                                    <label for="criterion-edit-content">Criterio @(position + 1) <span class="required">*</span></label>
                                    <textarea id="criterion-edit-content" @bind="editContent" @bind:event="oninput" @bind:after="ClearEditError"
                                              rows="4" disabled="@Busy"
                                              aria-invalid="@FieldValidation.AriaInvalid(editError, "content")"
                                              aria-describedby="@FieldValidation.DescribedBy(editError, "content", "criterion-edit-content")"></textarea>
                                    <small id="criterion-edit-content-hint">Escribe hasta 10.000 caracteres. El texto se guardará tal como lo envíes.</small>
                                    @if (editError?.HasField("content") == true)
                                    {
                                        <span id="criterion-edit-content-error" class="field-error">@FieldMessage(editError)</span>
                                    }
                                </div>
                                @if (confirmDiscard)
                                {
                                    <div class="notice" role="alert">
                                        <p>¿Descartar los cambios sin guardar?</p>
                                        <div class="form-actions">
                                            <button class="button primary" type="button" @onclick="DiscardEdit">Descartar cambios</button>
                                            <button class="button subtle" type="button" @onclick="() => confirmDiscard = false">Seguir editando</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-actions">
                                        <button class="button primary" type="submit" disabled="@(Busy || !HasEditChanges)">
                                            @(sending ? "Guardando…" : savedVersion is not null ? "Guardar mi versión" : "Guardar")
                                        </button>
                                        @if (savedVersion is not null)
                                        {
                                            <button class="button subtle" type="button" @onclick="DiscardEdit" disabled="@Busy">Descartar mi versión</button>
                                        }
                                        else
                                        {
                                            <button class="button subtle" type="button" @onclick="CancelEdit" disabled="@Busy">Cancelar</button>
                                        }
                                    </div>
                                }
                            </form>
                        }
                        else
                        {
                            <p class="criterion-content">@criterion.Content</p>
                            @if (confirmDeleteId == criterion.Id)
                            {
                                <div class="notice" role="alert">
                                    <p>¿Eliminar este criterio? También se eliminarán sus vínculos con tareas, si los tiene.</p>
                                    <div class="form-actions">
                                        <button class="button primary" type="button" @onclick="DeleteAsync" disabled="@Busy">
                                            @(sending ? "Eliminando…" : "Eliminar criterio")
                                        </button>
                                        <button class="button subtle" type="button" @onclick="() => confirmDeleteId = null" disabled="@Busy">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else if (Editable)
                            {
                                <div class="criterion-actions">
                                    <button class="button subtle small" type="button" @onclick="() => MoveAsync(position, -1)"
                                            disabled="@(ActionsLocked || position == 0)" aria-label="@($"Subir criterio {position + 1}")">Subir</button>
                                    <button class="button subtle small" type="button" @onclick="() => MoveAsync(position, 1)"
                                            disabled="@(ActionsLocked || position == criteria.Count - 1)" aria-label="@($"Bajar criterio {position + 1}")">Bajar</button>
                                    <button class="button subtle small" type="button" @onclick="() => StartEditAsync(criterion)"
                                            disabled="@(ActionsLocked || !string.IsNullOrEmpty(newContent))" aria-label="@($"Editar criterio {position + 1}")">Editar</button>
                                    <button class="button subtle small" type="button" @onclick="() => ConfirmDelete(criterion.Id)"
                                            disabled="@ActionsLocked" aria-label="@($"Eliminar criterio {position + 1}")">Eliminar</button>
                                </div>
                            }
                        }
                    </div>
                </li>
            }
        </ol>
    }

    @if (Specification.Status == "draft" && !Locked && criteria is not null)
    {
        <form class="form-card criterion-form" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="criterion-new-content">Nuevo criterio <span class="required">*</span></label>
                <textarea id="criterion-new-content" @bind="newContent" @bind:event="oninput" @bind:after="ClearAddError"
                          rows="3" disabled="@AddLocked"
                          aria-invalid="@FieldValidation.AriaInvalid(addError, "content")"
                          aria-describedby="@FieldValidation.DescribedBy(addError, "content", "criterion-new-content")"></textarea>
                <small id="criterion-new-content-hint">Describe un resultado verificable en un máximo de 10.000 caracteres.</small>
                @if (addError?.HasField("content") == true)
                {
                    <span id="criterion-new-content-error" class="field-error">@FieldMessage(addError)</span>
                }
            </div>
            <div class="form-actions">
                <button class="button primary" type="submit" disabled="@AddLocked">
                    @(sending && pendingOperation == Operation.Add ? "Añadiendo…" : "Añadir criterio")
                </button>
            </div>
        </form>
    }

    @if (unsavedText is not null)
    {
        <section class="detail-card unsaved-content" aria-label="Texto de criterio no guardado">
            <h3>Texto de criterio no guardado</h3>
            <p>No se pudo guardar. Puedes copiarlo antes de salir.</p>
            <p class="criterion-content">@unsavedText</p>
        </section>
    }
</section>

@code {
    public sealed record ContextLost(ApiError Error, string? LocalText);

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid ProposalId { get; set; }
    [Parameter, EditorRequired] public SpecificationDto Specification { get; set; } = default!;

    // True while the specification content is being edited or recovered in the page.
    [Parameter] public bool Locked { get; set; }
    [Parameter] public EventCallback<bool> OnActiveChanged { get; set; }
    [Parameter, EditorRequired] public Func<Task<ApiResult<SpecificationDto>>> ReloadSpecification { get; set; } = default!;
    [Parameter] public EventCallback<ContextLost> OnContextLost { get; set; }

    private enum Operation { Add, Edit, Delete, Reorder }

    private Guid? loadedFor;
    private List<AcceptanceCriterionDto>? criteria;
    private string? listEntityTag;
    private ApiError? listError;
    private bool loadingList;

    private string? newContent;
    private ApiError? addError;

    private Guid? editingId;
    private string? editContent;
    private string? editEntityTag;
    private string? savedVersion;
    private ApiError? editError;
    private bool confirmDiscard;

    private Guid? confirmDeleteId;

    private bool sending;
    private bool refreshing;
    private Operation? pending;
    private Operation? pendingOperation;
    private string? sentContent;
    private Guid? targetId;
    private List<Guid>? requestedOrder;

    private string? notice;
    private ApiError? noticeError;
    private string? unsavedText;
    private bool reportedActive;

    private bool Busy => sending || refreshing;
    private bool Editable => Specification.Status == "draft" && !Locked && pending is null;
    private bool AddLocked => Busy || editingId is not null || pending is not null;
    private bool ActionsLocked => Busy || editingId is not null || confirmDeleteId is not null;
    private bool HasEditChanges => editingId is { } id &&
        !string.Equals(editContent, criteria?.FirstOrDefault(c => c.Id == id)?.Content ?? savedVersion, StringComparison.Ordinal);
    private bool Active => editingId is not null || confirmDeleteId is not null || Busy || pending is not null ||
        !string.IsNullOrEmpty(newContent);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != Specification.Id)
        {
            loadedFor = Specification.Id;
            await LoadListAsync();
        }

        if (Specification.Status != "draft")
        {
            MoveLocalTextToUnsaved();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var active = Active;
        if (active != reportedActive)
        {
            reportedActive = active;
            await OnActiveChanged.InvokeAsync(active);
        }
    }

    private async Task LoadListAsync()
    {
        loadingList = true;
        listError = null;
        try
        {
            var result = await Api.ListAcceptanceCriteriaAsync(ProjectId, ProposalId);
            if (result.Value is { } current)
            {
                criteria = current;
                listEntityTag = result.EntityTag;
            }
            else
            {
                listError = result.Error;
            }
        }
        finally
        {
            loadingList = false;
        }
    }

    private void ClearAddError()
    {
        if (addError?.HasField("content") == true)
        {
            addError = null;
        }
    }

    private void ClearEditError()
    {
        confirmDiscard = false;
        if (editError?.HasField("content") == true)
        {
            editError = null;
        }
    }

    private async Task AddAsync()
    {
        if (!Editable || AddLocked) return;
        BeginSend(Operation.Add, newContent, null);
        addError = null;
        try
        {
            var result = await Api.CreateAcceptanceCriterionAsync(ProjectId, ProposalId, newContent);
            if (result.Value is not null)
            {
                newContent = null;
                await AfterChangeAsync("Criterio añadido.");
                return;
            }

            if (IsContentValidation(result.Error))
            {
                addError = result.Error;
                return;
            }

            await HandleFailureAsync(Operation.Add, result.Error);
        }
        finally
        {
            sending = false;
        }
    }

    private async Task StartEditAsync(AcceptanceCriterionDto criterion)
    {
        if (!Editable || ActionsLocked) return;
        sending = true;
        ClearNotice();
        try
        {
            var result = await Api.GetAcceptanceCriterionAsync(ProjectId, ProposalId, criterion.Id);
            if (result.Value is not { } current || result.EntityTag is null)
            {
                if (result.Error?.StatusCode == 404)
                {
                    await HandleMissingAsync(null);
                    return;
                }

                notice = "No se pudo abrir el criterio para editarlo.";
                noticeError = result.Error;
                return;
            }

            editingId = current.Id;
            editContent = current.Content;
            editEntityTag = result.EntityTag;
            savedVersion = null;
            editError = null;
            confirmDiscard = false;
            if (!string.Equals(current.Content, criterion.Content, StringComparison.Ordinal))
            {
                ReplaceCriterion(current);
                notice = "El criterio cambió desde que se cargó el listado. Se muestra su versión actual.";
            }
        }
        finally
        {
            sending = false;
        }
    }

    private void CancelEdit()
    {
        if (HasEditChanges)
        {
            confirmDiscard = true;
            return;
        }

        ExitEdit();
    }

    private void DiscardEdit()
    {
        ExitEdit();
        ClearNotice();
    }

    private void ExitEdit()
    {
        editingId = null;
        editContent = null;
        editEntityTag = null;
        savedVersion = null;
        editError = null;
        confirmDiscard = false;
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not { } id || editEntityTag is null || !Editable || Busy || !HasEditChanges) return;
        BeginSend(Operation.Edit, editContent, id);
        editError = null;
        try
        {
            var result = await Api.UpdateAcceptanceCriterionAsync(ProjectId, ProposalId, id, editContent, editEntityTag);
            if (result.Value is not null)
            {
                ExitEdit();
                await AfterChangeAsync("Criterio actualizado.");
                return;
            }

            if (IsContentValidation(result.Error))
            {
                editError = result.Error;
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                pending = Operation.Edit;
                notice = "El criterio cambió desde que empezaste a editarlo. Consultando su versión actual…";
            }
            else
            {
                await HandleFailureAsync(Operation.Edit, result.Error);
                return;
            }
        }
        finally
        {
            sending = false;
        }

        await RecoverAsync();
    }

    private void ConfirmDelete(Guid criterionId)
    {
        if (!Editable || ActionsLocked) return;
        ClearNotice();
        confirmDeleteId = criterionId;
    }

    private async Task DeleteAsync()
    {
        if (confirmDeleteId is not { } id || !Editable || Busy) return;
        var listed = criteria?.FirstOrDefault(c => c.Id == id);
        BeginSend(Operation.Delete, null, id);
        try
        {
            var current = await Api.GetAcceptanceCriterionAsync(ProjectId, ProposalId, id);
            if (current.Value is null || current.EntityTag is null)
            {
                confirmDeleteId = null;
                if (current.Error?.StatusCode == 404)
                {
                    await HandleMissingAsync(null);
                    return;
                }

                notice = "No se pudo comprobar el criterio antes de eliminarlo.";
                noticeError = current.Error;
                return;
            }

            if (!string.Equals(current.Value.Content, listed?.Content, StringComparison.Ordinal))
            {
                confirmDeleteId = null;
                await ReloadAllAsync();
                notice = "El criterio cambió desde que se cargó el listado. Revísalo antes de eliminarlo.";
                return;
            }

            var result = await Api.DeleteAcceptanceCriterionAsync(ProjectId, ProposalId, id, current.EntityTag);
            confirmDeleteId = null;
            if (result.IsSuccess)
            {
                await AfterChangeAsync("Criterio eliminado.");
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                notice = "El criterio cambió antes de eliminarlo. Revisa el listado actual.";
                return;
            }

            await HandleFailureAsync(Operation.Delete, result.Error);
        }
        finally
        {
            sending = false;
        }
    }

    private async Task MoveAsync(int index, int offset)
    {
        var target = index + offset;
        if (!Editable || ActionsLocked || criteria is null || listEntityTag is null ||
            target < 0 || target >= criteria.Count) return;

        var order = criteria.Select(c => c.Id).ToList();
        (order[index], order[target]) = (order[target], order[index]);
        BeginSend(Operation.Reorder, null, null);
        requestedOrder = order;
        try
        {
            var result = await Api.ReorderAcceptanceCriteriaAsync(ProjectId, ProposalId, order, listEntityTag);
            if (result.IsSuccess)
            {
                await AfterChangeAsync(null);
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                notice = "El listado de criterios cambió. Revisa el orden actual antes de moverlos.";
                return;
            }

            await HandleFailureAsync(Operation.Reorder, result.Error);
        }
        finally
        {
            sending = false;
        }
    }

    private void BeginSend(Operation operation, string? content, Guid? criterionId)
    {
        sending = true;
        ClearNotice();
        pendingOperation = operation;
        sentContent = content;
        targetId = criterionId;
        requestedOrder = null;
    }

    // The specification ETag covers the whole plan, so it is refreshed after every criteria change.
    private async Task AfterChangeAsync(string? message)
    {
        var specification = await ReloadSpecification();
        await LoadListAsync();
        notice = message;
        if (specification.Value is null)
        {
            notice = $"{message} No se pudo actualizar la especificación; consúltala de nuevo antes de editar su contenido.".TrimStart();
            noticeError = specification.Error;
        }
    }

    private async Task HandleFailureAsync(Operation operation, ApiError? error)
    {
        switch (error?.StatusCode)
        {
            case 409:
                await ClassifyConflictAsync(operation);
                break;
            case 404:
                await HandleMissingAsync(operation is Operation.Add or Operation.Edit ? sentContent : null);
                break;
            case null or >= 500:
                pending = operation;
                notice = "No se sabe si el cambio se aplicó. Consulta el estado actual antes de intentarlo de nuevo.";
                noticeError = error;
                break;
            default:
                pending = operation;
                notice = "No se pudo completar la operación. Consulta el estado actual antes de intentarlo de nuevo.";
                break;
        }
    }

    private async Task ClassifyConflictAsync(Operation operation)
    {
        var specification = await ReloadSpecification();
        if (specification.Value is not { } current)
        {
            await HandleSpecificationErrorAsync(operation, specification.Error);
            return;
        }

        if (current.Status != "draft")
        {
            await LoadListAsync();
            MoveLocalTextToUnsaved();
            notice = "La especificación ya no está en borrador y sus criterios se muestran en modo de lectura.";
            return;
        }

        switch (operation)
        {
            case Operation.Add:
                addError = DuplicateError();
                break;
            case Operation.Edit:
                editError = DuplicateError();
                break;
            default:
                await LoadListAsync();
                notice = "El listado de criterios cambió. Revisa el listado actual.";
                break;
        }
    }

    private async Task HandleMissingAsync(string? localText)
    {
        var specification = await ReloadSpecification();
        if (specification.Value is null)
        {
            if (specification.Error?.StatusCode == 404)
            {
                await OnContextLost.InvokeAsync(new ContextLost(specification.Error, localText ?? LocalText()));
                return;
            }

            notice = "No se pudo comprobar el estado actual de la especificación.";
            noticeError = specification.Error;
            return;
        }

        if (editingId is not null)
        {
            unsavedText = editContent;
            ExitEdit();
        }

        await LoadListAsync();
        notice = "El criterio ya no existe. Se muestra el listado actual.";
    }

    private async Task HandleSpecificationErrorAsync(Operation operation, ApiError? error)
    {
        if (error?.StatusCode == 404)
        {
            await OnContextLost.InvokeAsync(new ContextLost(error, LocalText()));
            return;
        }

        pending = operation;
        notice = "No se pudo comprobar el estado actual de la especificación.";
        noticeError = error;
    }

    private async Task RecoverAsync()
    {
        if (refreshing || pending is not { } operation) return;
        refreshing = true;
        noticeError = null;
        try
        {
            var specification = await ReloadSpecification();
            if (specification.Value is not { } current)
            {
                await HandleSpecificationErrorAsync(operation, specification.Error);
                return;
            }

            var list = await Api.ListAcceptanceCriteriaAsync(ProjectId, ProposalId);
            if (list.Value is not { } currentCriteria)
            {
                notice = "No se pudo consultar el listado actual de criterios.";
                noticeError = list.Error;
                return;
            }

            criteria = currentCriteria;
            listEntityTag = list.EntityTag;
            listError = null;
            pending = null;
            notice = await ResolveRecoveryAsync(operation, currentCriteria);

            if (current.Status != "draft")
            {
                MoveLocalTextToUnsaved();
                notice = $"{notice} La especificación ya no está en borrador y sus criterios se muestran en modo de lectura.";
            }
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task<string> ResolveRecoveryAsync(Operation operation, List<AcceptanceCriterionDto> current)
    {
        switch (operation)
        {
            case Operation.Add:
                if (current.Any(c => string.Equals(c.Content, sentContent, StringComparison.Ordinal)))
                {
                    if (string.Equals(newContent, sentContent, StringComparison.Ordinal))
                    {
                        newContent = null;
                    }
                    return "El criterio se añadió correctamente.";
                }
                return "El criterio no se añadió. Tu texto sigue en el campo.";

            case Operation.Edit:
                var target = current.FirstOrDefault(c => c.Id == targetId);
                if (target is null)
                {
                    unsavedText = editContent ?? sentContent;
                    ExitEdit();
                    return "El criterio ya no existe. Tu texto no se guardó y se muestra abajo.";
                }

                if (string.Equals(target.Content, editContent, StringComparison.Ordinal))
                {
                    ExitEdit();
                    return "El criterio ya tiene el texto que enviaste.";
                }

                var fresh = await Api.GetAcceptanceCriterionAsync(ProjectId, ProposalId, target.Id);
                if (fresh.Value is null || fresh.EntityTag is null)
                {
                    pending = Operation.Edit;
                    noticeError = fresh.Error;
                    return "No se pudo consultar la versión actual del criterio. Tu texto sigue en el campo.";
                }

                ReplaceCriterion(fresh.Value);
                editingId = target.Id;
                editEntityTag = fresh.EntityTag;
                savedVersion = fresh.Value.Content;
                return "Tu cambio no se guardó. Compara tu texto con la versión guardada y decide si guardas la tuya.";

            case Operation.Delete:
                return current.Any(c => c.Id == targetId)
                    ? "El criterio no se eliminó. Puedes intentarlo de nuevo."
                    : "El criterio se eliminó correctamente.";

            default:
                return requestedOrder is not null && current.Select(c => c.Id).SequenceEqual(requestedOrder)
                    ? "El nuevo orden se guardó correctamente."
                    : "El orden no cambió. Revisa el listado actual.";
        }
    }

    private async Task ReloadAllAsync()
    {
        await ReloadSpecification();
        await LoadListAsync();
    }

    private void ReplaceCriterion(AcceptanceCriterionDto current)
    {
        var index = criteria?.FindIndex(c => c.Id == current.Id) ?? -1;
        if (index >= 0)
        {
            criteria![index] = current;
        }
    }

    private string? LocalText() =>
        editingId is not null ? editContent : string.IsNullOrEmpty(newContent) ? null : newContent;

    private void MoveLocalTextToUnsaved()
    {
        var local = LocalText();
        if (local is not null)
        {
            unsavedText = local;
        }

        newContent = null;
        addError = null;
        confirmDeleteId = null;
        ExitEdit();
    }

    private void ClearNotice()
    {
        notice = null;
        noticeError = null;
    }

    private static bool IsContentValidation(ApiError? error) =>
        error is { StatusCode: 400 } && error.HasField("content");

    private static ApiError DuplicateError() =>
        new(409, "Ya existe un criterio con ese texto.", new HashSet<string> { "content" });

    private static string FieldMessage(ApiError error) => error.StatusCode == 409
        ? "Ya existe un criterio con ese texto en esta especificación."
        : "Introduce un criterio de hasta 10.000 caracteres.";
}
