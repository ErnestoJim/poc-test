@using SpecFlow.Web.Services
@inherits PlanSectionBase<TaskOperation>

<section class="section-block tasks-section" aria-labelledby="tasks-heading">
    <div class="section-heading">
        <h2 id="tasks-heading">Tareas de implementación</h2>
        @if (tasks is not null)
        {
            <span class="count-pill">@tasks.Count</span>
        }
    </div>

    <StatusNotice Message="@Notice" Error="@NoticeError" CanRecover="@(Pending is not null)" Refreshing="@Refreshing" OnRecover="RecoverAsync" />

    @if ((Specification.Status is "draft" or "approved") && Locked)
    {
        <p class="section-hint">Termina la edición en curso para modificar las tareas.</p>
    }

    @if (coverageError is not null && tasks is { Count: > 0 })
    {
        <div class="notice error" role="alert">
            <p>No se pudo consultar qué criterios cubre cada tarea. @coverageError.Message</p>
            <button class="button subtle" @onclick="LoadCoverageAsync" disabled="@loadingCoverage">Reintentar</button>
        </div>
    }
    else if (Specification.Status == "draft" && criteria is not null && links is not null)
    {
        <p class="summary-banner @(UncoveredNumbers.Count == 0 ? "covered" : "uncovered")">@CoverageSummary</p>
    }

    @if (loadingList)
    {
        <p class="notice">Cargando tareas…</p>
    }
    else if (listError is not null)
    {
        <div class="notice error" role="alert">
            <p>No se pudieron cargar las tareas. @listError.Message</p>
            <button class="button subtle" @onclick="LoadListAsync">Reintentar</button>
        </div>
    }
    else if (tasks is { Count: 0 })
    {
        <div class="empty-state compact section-empty">
            <h3>Todavía no hay tareas</h3>
            <p>Una especificación necesita al menos una tarea de implementación antes de aprobarse.</p>
        </div>
    }
    else if (tasks is not null)
    {
        <ol class="item-list">
            @for (var index = 0; index < tasks.Count; index++)
            {
                var task = tasks[index];
                var position = index;
                <li class="item-row" @key="task.Id">
                    <span class="item-number" aria-hidden="true">@(position + 1)</span>
                    <div class="item-body">
                        @if (editingId == task.Id)
                        {
                            @if (savedVersion is not null)
                            {
                                <div class="saved-version item-saved-version">
                                    <p><strong>Versión guardada actual</strong>. Tu texto sigue en los campos sin guardar.</p>
                                    <p class="item-title">@savedVersion.Title</p>
                                    @if (savedVersion.Description is not null)
                                    {
                                        <p class="item-content">@savedVersion.Description</p>
                                    }
                                </div>
                            }
                            <form @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                <div class="field">
                                    <label for="task-edit-title">Título de la tarea @(position + 1) <span class="required">*</span></label>
                                    <input id="task-edit-title" @bind="editTitle" @bind:event="oninput" @bind:after="ClearEditErrors"
                                           disabled="@Busy"
                                           aria-invalid="@FieldValidation.AriaInvalid(editError, "title")"
                                           aria-describedby="@FieldValidation.DescribedBy(editError, "title", "task-edit-title")" />
                                    <small id="task-edit-title-hint">Hasta 200 caracteres, único en la especificación sin distinguir mayúsculas.</small>
                                    @if (editError?.HasField("title") == true)
                                    {
                                        <span id="task-edit-title-error" class="field-error">@TitleMessage(editError)</span>
                                    }
                                </div>
                                <div class="field">
                                    <label for="task-edit-description">Descripción <span class="optional">(opcional)</span></label>
                                    <textarea id="task-edit-description" @bind="editDescription" @bind:event="oninput" @bind:after="ClearEditErrors"
                                              rows="4" disabled="@Busy"
                                              aria-invalid="@FieldValidation.AriaInvalid(editError, "description")"
                                              aria-describedby="@FieldValidation.DescribedBy(editError, "description", "task-edit-description")"></textarea>
                                    <small id="task-edit-description-hint">Hasta 10.000 caracteres. Déjala vacía si la tarea no necesita descripción.</small>
                                    @if (editError?.HasField("description") == true)
                                    {
                                        <span id="task-edit-description-error" class="field-error">@DescriptionMessage</span>
                                    }
                                </div>
                                @if (confirmDiscard)
                                {
                                    <DiscardConfirmation OnDiscard="DiscardEdit" OnKeep="() => confirmDiscard = false" />
                                }
                                else
                                {
                                    <div class="form-actions">
                                        <button class="button primary" type="submit" disabled="@(Busy || !HasEditChanges)">
                                            @(Sending ? "Guardando…" : savedVersion is not null ? "Guardar mi versión" : "Guardar")
                                        </button>
                                        @if (savedVersion is not null)
                                        {
                                            <button class="button subtle" type="button" @onclick="DiscardEdit" disabled="@Busy">Descartar mi versión</button>
                                        }
                                        else
                                        {
                                            <button class="button subtle" type="button" @onclick="CancelEdit" disabled="@Busy">Cancelar</button>
                                        }
                                    </div>
                                }
                            </form>
                        }
                        else
                        {
                            <div class="item-heading">
                                <p class="item-title">@task.Title</p>
                                <span class="status @task.Status">@DisplayText.TaskStatus(task.Status)</span>
                            </div>
                            @if (task.Description is not null)
                            {
                                <p class="item-content">@task.Description</p>
                            }
                            @if (task.StartedAtUtc is not null || task.CompletedAtUtc is not null)
                            {
                                <p class="item-meta">
                                    @if (task.StartedAtUtc is { } startedAt)
                                    {
                                        <span>Iniciada el @DisplayText.DateTime(startedAt)</span>
                                    }
                                    @if (task.CompletedAtUtc is { } completedAt)
                                    {
                                        <span>Completada el @DisplayText.DateTime(completedAt)</span>
                                    }
                                </p>
                            }
                            @if (CoverageText(task.Id) is { } coverage)
                            {
                                <p class="task-coverage">@coverage</p>
                            }

                            @if (linkingId == task.Id)
                            {
                                <form class="inline-form choice-form" @onsubmit="SaveLinksAsync" @onsubmit:preventDefault>
                                    @if (linkSavedVersion is not null)
                                    {
                                        <div class="saved-version item-saved-version">
                                            <p><strong>Selección guardada actual</strong>: @SelectionText(linkSavedVersion). Tu selección sigue marcada sin guardar.</p>
                                        </div>
                                    }
                                    <fieldset disabled="@LinksLocked">
                                        <legend>Criterios que cubre la tarea @(position + 1)</legend>
                                        @if (criteria is { Count: 0 })
                                        {
                                            <p class="section-hint">Todavía no hay criterios que vincular.</p>
                                        }
                                        @foreach (var (criterion, criterionIndex) in (criteria ?? []).Select((c, i) => (c, i)))
                                        {
                                            var criterionId = criterion.Id;
                                            <label class="choice-option" @key="criterionId">
                                                <input type="checkbox" checked="@linkSelection.Contains(criterionId)"
                                                       @onchange="e => ToggleCriterion(criterionId, e.Value is true)" />
                                                <span class="item-number">@(criterionIndex + 1)</span>
                                                <span class="item-content">@criterion.Content</span>
                                            </label>
                                        }
                                    </fieldset>
                                    @if (confirmDiscard)
                                    {
                                        <DiscardConfirmation Question="¿Descartar la selección sin guardar?" KeepLabel="Seguir eligiendo" OnDiscard="DiscardLinks" OnKeep="() => confirmDiscard = false" />
                                    }
                                    else
                                    {
                                        <div class="form-actions">
                                            <button class="button primary" type="submit" disabled="@(LinksLocked || !HasLinkChanges)">
                                                @(Sending ? "Guardando…" : linkSavedVersion is not null ? "Guardar mi selección" : "Guardar vínculos")
                                            </button>
                                            @if (linkSavedVersion is not null)
                                            {
                                                <button class="button subtle" type="button" @onclick="DiscardLinks" disabled="@LinksLocked">Descartar mi selección</button>
                                            }
                                            else
                                            {
                                                <button class="button subtle" type="button" @onclick="CancelLinks" disabled="@LinksLocked">Cancelar</button>
                                            }
                                        </div>
                                    }
                                </form>
                            }
                            else if (confirmDeleteId == task.Id)
                            {
                                <div class="notice" role="alert">
                                    <p>¿Eliminar esta tarea? También se eliminarán sus vínculos con criterios, si los tiene.</p>
                                    <div class="form-actions">
                                        <button class="button primary" type="button" @onclick="DeleteAsync" disabled="@Busy">
                                            @(Sending ? "Eliminando…" : "Eliminar tarea")
                                        </button>
                                        <button class="button subtle" type="button" @onclick="() => confirmDeleteId = null" disabled="@Busy">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else if (confirmTransitionId == task.Id && confirmTransition is { } transition)
                            {
                                <div class="notice" role="alert">
                                    <p>@(transition == TaskOperation.Start
                                        ? "¿Iniciar esta tarea? No se podrá volver a dejarla pendiente."
                                        : "¿Completar esta tarea? No se podrá reabrir después.")</p>
                                    <div class="form-actions">
                                        <button class="button primary" type="button" @onclick="TransitionAsync" disabled="@Busy">
                                            @(Sending ? "Guardando…" : transition == TaskOperation.Start ? "Confirmar inicio" : "Confirmar finalización")
                                        </button>
                                        <button class="button subtle" type="button" @onclick="CancelTransition" disabled="@Busy">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else if (Planning)
                            {
                                <div class="item-actions">
                                    <button class="button subtle small" type="button" @onclick="() => MoveAsync(position, -1)"
                                            disabled="@(ActionsLocked || position == 0)" aria-label="@($"Subir tarea {position + 1}")">Subir</button>
                                    <button class="button subtle small" type="button" @onclick="() => MoveAsync(position, 1)"
                                            disabled="@(ActionsLocked || position == tasks.Count - 1)" aria-label="@($"Bajar tarea {position + 1}")">Bajar</button>
                                    <button class="button subtle small" type="button" @onclick="() => StartEditAsync(task)"
                                            disabled="@(ActionsLocked || HasNewText)" aria-label="@($"Editar tarea {position + 1}")">Editar</button>
                                    <button class="button subtle small" type="button" @onclick="() => StartLinksAsync(task.Id)"
                                            disabled="@(ActionsLocked || HasNewText || criteria is null || links is null)"
                                            aria-label="@($"Vincular criterios a la tarea {position + 1}")">Vincular criterios</button>
                                    <button class="button subtle small" type="button" @onclick="() => ConfirmDelete(task.Id)"
                                            disabled="@ActionsLocked" aria-label="@($"Eliminar tarea {position + 1}")">Eliminar</button>
                                </div>
                            }
                            else if (Executing && task.Status is "pending" or "in_progress")
                            {
                                <div class="item-actions">
                                    @if (task.Status == "pending")
                                    {
                                        <button class="button subtle small" type="button" @onclick="() => ConfirmTransitionFor(task.Id, TaskOperation.Start)"
                                                disabled="@ActionsLocked" aria-label="@($"Iniciar tarea {position + 1}")">Iniciar</button>
                                    }
                                    else
                                    {
                                        <button class="button subtle small" type="button" @onclick="() => ConfirmTransitionFor(task.Id, TaskOperation.Complete)"
                                                disabled="@ActionsLocked" aria-label="@($"Completar tarea {position + 1}")">Completar</button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </li>
            }
        </ol>
    }

    @if (Specification.Status == "draft" && !Locked && tasks is not null)
    {
        <form class="form-card inline-form" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="task-new-title">Nueva tarea <span class="required">*</span></label>
                <input id="task-new-title" @bind="newTitle" @bind:event="oninput" @bind:after="ClearAddErrors"
                       disabled="@AddLocked"
                       aria-invalid="@FieldValidation.AriaInvalid(addError, "title")"
                       aria-describedby="@FieldValidation.DescribedBy(addError, "title", "task-new-title")" />
                <small id="task-new-title-hint">Hasta 200 caracteres, único en la especificación sin distinguir mayúsculas.</small>
                @if (addError?.HasField("title") == true)
                {
                    <span id="task-new-title-error" class="field-error">@TitleMessage(addError)</span>
                }
            </div>
            <div class="field">
                <label for="task-new-description">Descripción <span class="optional">(opcional)</span></label>
                <textarea id="task-new-description" @bind="newDescription" @bind:event="oninput" @bind:after="ClearAddErrors"
                          rows="3" disabled="@AddLocked"
                          aria-invalid="@FieldValidation.AriaInvalid(addError, "description")"
                          aria-describedby="@FieldValidation.DescribedBy(addError, "description", "task-new-description")"></textarea>
                <small id="task-new-description-hint">Hasta 10.000 caracteres. Déjala vacía si la tarea no necesita descripción.</small>
                @if (addError?.HasField("description") == true)
                {
                    <span id="task-new-description-error" class="field-error">@DescriptionMessage</span>
                }
            </div>
            <div class="form-actions">
                <button class="button primary" type="submit" disabled="@AddLocked">
                    @(Sending && pendingOperation == TaskOperation.Add ? "Añadiendo…" : "Añadir tarea")
                </button>
            </div>
        </form>
    }

    <UnsavedTextBlock Title="Texto de tarea no guardado" Text="@unsavedText" />

    <UnsavedTextBlock Title="Selección de criterios no guardada" Text="@unsavedLinks" Hint="No se pudo guardar. Puedes anotarla antes de salir." />
</section>

@code {
    private sealed record TaskText(string Title, string? Description);

    private const string DescriptionMessage = "Escribe una descripción con contenido de hasta 10.000 caracteres o déjala vacía.";

    private Guid? loadedFor;
    private List<ImplementationTaskDto>? tasks;
    private string? listEntityTag;
    private ApiError? listError;
    private bool loadingList;

    private List<AcceptanceCriterionDto>? criteria;
    private Dictionary<Guid, IReadOnlyList<Guid>>? links;
    private ApiError? coverageError;
    private bool loadingCoverage;
    private string? coverageTag;
    private int coverageVersion;

    private Guid? linkingId;
    private HashSet<Guid> linkSelection = [];
    private HashSet<Guid> linkBaseline = [];
    private string? linkEntityTag;
    private HashSet<Guid>? linkSavedVersion;
    private List<Guid>? sentLinks;

    private string? newTitle;
    private string? newDescription;
    private ApiError? addError;

    private Guid? editingId;
    private string? editTitle;
    private string? editDescription;
    private string? editEntityTag;
    private TaskText? savedVersion;
    private ApiError? editError;
    private bool confirmDiscard;

    private Guid? confirmDeleteId;
    private Guid? confirmTransitionId;
    private TaskOperation? confirmTransition;

    private TaskOperation? pendingOperation;
    private TaskText? sentText;
    private Guid? targetId;
    private List<Guid>? requestedOrder;

    private string? unsavedText;
    private string? unsavedLinks;

    private bool Planning => Specification.Status == "draft" && !Locked && Pending is null;
    private bool Executing => Specification.Status == "approved" && !Locked && Pending is null;
    private bool HasNewText => !string.IsNullOrEmpty(newTitle) || !string.IsNullOrEmpty(newDescription);
    private bool AddLocked => Busy || editingId is not null || linkingId is not null || Pending is not null;
    private bool ActionsLocked => Busy || editingId is not null || linkingId is not null ||
        confirmDeleteId is not null || confirmTransitionId is not null;
    // Nothing is resent while the outcome of a link save is unknown.
    private bool LinksLocked => Busy || Pending is not null;
    private bool HasLinkChanges => linkingId is not null && !linkSelection.SetEquals(linkBaseline);
    private bool HasEditChanges => editingId is { } id && tasks?.FirstOrDefault(t => t.Id == id) is { } saved &&
        (!string.Equals(editTitle, saved.Title, StringComparison.Ordinal) ||
         !string.Equals(Normalize(editDescription), saved.Description, StringComparison.Ordinal));
    protected override bool Active => editingId is not null || linkingId is not null || confirmDeleteId is not null ||
        confirmTransitionId is not null || Busy || Pending is not null || HasNewText;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != Specification.Id)
        {
            loadedFor = Specification.Id;
            await LoadListAsync();
        }
        else if (SpecificationEntityTag != coverageTag && !Busy && !loadingList && tasks is not null)
        {
            // The plan changed outside this section, for example a criterion deleted or reordered.
            await LoadCoverageAsync();
        }

        if (Specification.Status != "draft")
        {
            MoveLocalTextToUnsaved();
        }

        if (Specification.Status != "approved")
        {
            CancelTransition();
        }
    }

    protected override async Task LoadListAsync()
    {
        loadingList = true;
        listError = null;
        try
        {
            var result = await Api.ListImplementationTasksAsync(ProjectId, ProposalId);
            if (result.Value is { } current)
            {
                tasks = current;
                listEntityTag = result.EntityTag;
            }
            else
            {
                listError = result.Error;
            }
        }
        finally
        {
            loadingList = false;
        }

        if (tasks is not null && listError is null)
        {
            await LoadCoverageAsync();
        }
    }

    // Coverage is computed here from the criteria list and the links of every task.
    private async Task LoadCoverageAsync()
    {
        if (tasks is not { } currentTasks) return;
        var version = ++coverageVersion;
        coverageTag = SpecificationEntityTag;
        loadingCoverage = true;
        try
        {
            var criteriaResult = await Api.ListAcceptanceCriteriaAsync(ProjectId, ProposalId);
            var linkResults = await Task.WhenAll(currentTasks.Select(async task =>
                (task.Id, Result: await Api.GetTaskAcceptanceCriteriaAsync(ProjectId, ProposalId, task.Id))));
            if (version != coverageVersion) return;

            var failure = criteriaResult.Error ?? linkResults.Select(r => r.Result.Error).FirstOrDefault(e => e is not null);
            if (criteriaResult.Value is not { } currentCriteria || failure is not null)
            {
                coverageError = failure ?? criteriaResult.Error;
                links = null;
                return;
            }

            criteria = currentCriteria;
            links = linkResults.ToDictionary(r => r.Id, r => r.Result.Value!.AcceptanceCriterionIds);
            coverageError = null;
        }
        finally
        {
            if (version == coverageVersion)
            {
                loadingCoverage = false;
            }
        }
    }

    private void ClearAddErrors()
    {
        if (HasFieldError(addError))
        {
            addError = null;
        }
    }

    private void ClearEditErrors()
    {
        confirmDiscard = false;
        if (HasFieldError(editError))
        {
            editError = null;
        }
    }

    private async Task AddAsync()
    {
        if (!Planning || AddLocked) return;
        var text = new TaskText(newTitle ?? "", Normalize(newDescription));
        BeginSend(TaskOperation.Add, text, null);
        addError = null;
        try
        {
            var result = await Api.CreateImplementationTaskAsync(ProjectId, ProposalId, newTitle, text.Description);
            if (result.Value is not null)
            {
                newTitle = null;
                newDescription = null;
                await AfterChangeAsync("Tarea añadida.");
                return;
            }

            if (IsFieldValidation(result.Error))
            {
                addError = result.Error;
                return;
            }

            await HandleFailureAsync(TaskOperation.Add, result.Error);
        }
        finally
        {
            Sending = false;
        }
    }

    private async Task StartEditAsync(ImplementationTaskDto task)
    {
        if (!Planning || ActionsLocked) return;
        Sending = true;
        ClearNotice();
        try
        {
            var result = await Api.GetImplementationTaskAsync(ProjectId, ProposalId, task.Id);
            if (result.Value is not { } current || result.EntityTag is null)
            {
                if (result.Error?.StatusCode == 404)
                {
                    await HandleMissingTaskAsync(null);
                    return;
                }

                Notice = "No se pudo abrir la tarea para editarla.";
                NoticeError = result.Error;
                return;
            }

            editingId = current.Id;
            editTitle = current.Title;
            editDescription = current.Description;
            editEntityTag = result.EntityTag;
            savedVersion = null;
            editError = null;
            confirmDiscard = false;
            if (current != task)
            {
                ReplaceTask(current);
                Notice = "La tarea cambió desde que se cargó el listado. Se muestra su versión actual.";
            }
        }
        finally
        {
            Sending = false;
        }
    }

    private void CancelEdit()
    {
        if (HasEditChanges)
        {
            confirmDiscard = true;
            return;
        }

        ExitEdit();
    }

    private void DiscardEdit()
    {
        ExitEdit();
        ClearNotice();
    }

    private void ExitEdit()
    {
        editingId = null;
        editTitle = null;
        editDescription = null;
        editEntityTag = null;
        savedVersion = null;
        editError = null;
        confirmDiscard = false;
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not { } id || editEntityTag is null || !Planning || Busy || !HasEditChanges) return;
        var text = new TaskText(editTitle ?? "", Normalize(editDescription));
        BeginSend(TaskOperation.Edit, text, id);
        editError = null;
        try
        {
            var result = await Api.UpdateImplementationTaskAsync(ProjectId, ProposalId, id, editTitle, text.Description, editEntityTag);
            if (result.Value is not null)
            {
                ExitEdit();
                await AfterChangeAsync("Tarea actualizada.");
                return;
            }

            if (IsFieldValidation(result.Error))
            {
                editError = result.Error;
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                Pending = TaskOperation.Edit;
                Notice = "La tarea cambió desde que empezaste a editarla. Consultando su versión actual…";
            }
            else
            {
                await HandleFailureAsync(TaskOperation.Edit, result.Error);
                return;
            }
        }
        finally
        {
            Sending = false;
        }

        await RecoverAsync();
    }

    private void ConfirmDelete(Guid taskId)
    {
        if (!Planning || ActionsLocked) return;
        ClearNotice();
        confirmDeleteId = taskId;
    }

    private async Task DeleteAsync()
    {
        if (confirmDeleteId is not { } id || !Planning || Busy) return;
        var listed = tasks?.FirstOrDefault(t => t.Id == id);
        BeginSend(TaskOperation.Delete, null, id);
        try
        {
            var current = await Api.GetImplementationTaskAsync(ProjectId, ProposalId, id);
            if (current.Value is null || current.EntityTag is null)
            {
                confirmDeleteId = null;
                if (current.Error?.StatusCode == 404)
                {
                    await HandleMissingTaskAsync(null);
                    return;
                }

                Notice = "No se pudo comprobar la tarea antes de eliminarla.";
                NoticeError = current.Error;
                return;
            }

            if (listed is null || current.Value.Title != listed.Title || current.Value.Description != listed.Description)
            {
                confirmDeleteId = null;
                await ReloadAllAsync();
                Notice = "La tarea cambió desde que se cargó el listado. Revísala antes de eliminarla.";
                return;
            }

            var result = await Api.DeleteImplementationTaskAsync(ProjectId, ProposalId, id, current.EntityTag);
            confirmDeleteId = null;
            if (result.IsSuccess)
            {
                await AfterChangeAsync("Tarea eliminada.");
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                Notice = "La tarea cambió antes de eliminarla. Revisa el listado actual.";
                return;
            }

            await HandleFailureAsync(TaskOperation.Delete, result.Error);
        }
        finally
        {
            Sending = false;
        }
    }

    private async Task MoveAsync(int index, int offset)
    {
        var target = index + offset;
        if (!Planning || ActionsLocked || tasks is null || listEntityTag is null ||
            target < 0 || target >= tasks.Count) return;

        var order = tasks.Select(t => t.Id).ToList();
        (order[index], order[target]) = (order[target], order[index]);
        BeginSend(TaskOperation.Reorder, null, null);
        requestedOrder = order;
        try
        {
            var result = await Api.ReorderImplementationTasksAsync(ProjectId, ProposalId, order, listEntityTag);
            if (result.IsSuccess)
            {
                await AfterChangeAsync(null);
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                Notice = "El listado de tareas cambió. Revisa el orden actual antes de moverlas.";
                return;
            }

            await HandleFailureAsync(TaskOperation.Reorder, result.Error);
        }
        finally
        {
            Sending = false;
        }
    }

    private void ConfirmTransitionFor(Guid taskId, TaskOperation transition)
    {
        if (!Executing || ActionsLocked) return;
        ClearNotice();
        confirmTransitionId = taskId;
        confirmTransition = transition;
    }

    private void CancelTransition()
    {
        confirmTransitionId = null;
        confirmTransition = null;
    }

    private async Task TransitionAsync()
    {
        if (confirmTransitionId is not { } id || confirmTransition is not { } transition || !Executing || Busy) return;
        var expectedStatus = transition == TaskOperation.Start ? "pending" : "in_progress";
        BeginSend(transition, null, id);
        try
        {
            var current = await Api.GetImplementationTaskAsync(ProjectId, ProposalId, id);
            CancelTransition();
            if (current.Value is null || current.EntityTag is null)
            {
                if (current.Error?.StatusCode == 404)
                {
                    await HandleMissingTaskAsync(null);
                    return;
                }

                Notice = "No se pudo comprobar la tarea antes de cambiar su estado.";
                NoticeError = current.Error;
                return;
            }

            if (current.Value.Status != expectedStatus)
            {
                ReplaceTask(current.Value);
                Notice = "La tarea ya cambió de estado. Se muestra su estado actual.";
                return;
            }

            var result = transition == TaskOperation.Start
                ? await Api.StartImplementationTaskAsync(ProjectId, ProposalId, id, current.EntityTag)
                : await Api.CompleteImplementationTaskAsync(ProjectId, ProposalId, id, current.EntityTag);
            if (result.Value is not null)
            {
                await AfterChangeAsync(transition == TaskOperation.Start ? "Tarea iniciada." : "Tarea completada.");
                return;
            }

            if (result.Error?.StatusCode == 412)
            {
                await ReloadAllAsync();
                Notice = "La tarea cambió antes de aplicar el cambio. Se muestra su estado actual.";
                return;
            }

            await HandleFailureAsync(transition, result.Error);
        }
        finally
        {
            Sending = false;
        }
    }

    private async Task StartLinksAsync(Guid taskId)
    {
        if (!Planning || ActionsLocked || HasNewText || criteria is null || links is null) return;
        Sending = true;
        ClearNotice();
        try
        {
            var result = await Api.GetTaskAcceptanceCriteriaAsync(ProjectId, ProposalId, taskId);
            if (result.Value is not { } current || result.EntityTag is null)
            {
                if (result.Error?.StatusCode == 404)
                {
                    await HandleMissingTaskAsync(null);
                    return;
                }

                Notice = "No se pudieron consultar los criterios de la tarea.";
                NoticeError = result.Error;
                return;
            }

            linkingId = taskId;
            linkBaseline = [.. current.AcceptanceCriterionIds];
            linkSelection = [.. linkBaseline];
            linkEntityTag = result.EntityTag;
            linkSavedVersion = null;
            confirmDiscard = false;
            if (!links.TryGetValue(taskId, out var listed) || !linkBaseline.SetEquals(listed))
            {
                links[taskId] = current.AcceptanceCriterionIds;
                Notice = "Los criterios de la tarea cambiaron desde que se cargó la vista. Se muestran los actuales.";
            }
        }
        finally
        {
            Sending = false;
        }
    }

    private void ToggleCriterion(Guid criterionId, bool selected)
    {
        confirmDiscard = false;
        if (selected)
        {
            linkSelection.Add(criterionId);
        }
        else
        {
            linkSelection.Remove(criterionId);
        }
    }

    private void CancelLinks()
    {
        if (HasLinkChanges)
        {
            confirmDiscard = true;
            return;
        }

        ExitLinks();
    }

    private void DiscardLinks()
    {
        ExitLinks();
        ClearNotice();
    }

    private void ExitLinks()
    {
        linkingId = null;
        linkSelection = [];
        linkBaseline = [];
        linkEntityTag = null;
        linkSavedVersion = null;
        confirmDiscard = false;
    }

    private async Task SaveLinksAsync()
    {
        if (linkingId is not { } id || linkEntityTag is null || !Planning || Busy || !HasLinkChanges) return;
        BeginSend(TaskOperation.Link, null, id);
        // Sent in the order the criteria are shown; the API treats the list as a set.
        sentLinks = OrderedSelection(linkSelection);
        try
        {
            var result = await Api.ReplaceTaskAcceptanceCriteriaAsync(ProjectId, ProposalId, id, sentLinks, linkEntityTag);
            if (result.IsSuccess)
            {
                ExitLinks();
                await AfterChangeAsync("Vínculos guardados.");
                return;
            }

            switch (result.Error?.StatusCode)
            {
                case 412:
                    Pending = TaskOperation.Link;
                    Notice = "Los criterios de la tarea cambiaron desde que empezaste a elegirlos. Consultando la selección actual…";
                    break;
                case 404:
                    await HandleLinkTargetMissingAsync(id);
                    return;
                default:
                    await HandleFailureAsync(TaskOperation.Link, result.Error);
                    return;
            }
        }
        finally
        {
            Sending = false;
        }

        await RecoverAsync();
    }

    // The API checks that every criterion exists before If-Match, so a criterion deleted meanwhile answers 404.
    private async Task HandleLinkTargetMissingAsync(Guid taskId)
    {
        var specification = await ReloadSpecification();
        if (specification.Value is null)
        {
            if (specification.Error?.StatusCode == 404)
            {
                await OnContextLost.InvokeAsync(new ContextLost(specification.Error, LinkText()));
                return;
            }

            Pending = TaskOperation.Link;
            Notice = "No se pudo comprobar el estado actual de la especificación.";
            NoticeError = specification.Error;
            return;
        }

        await LoadListAsync();
        if (tasks?.Any(t => t.Id == taskId) != true)
        {
            ExitLinks();
            Notice = "La tarea ya no existe. Se muestra el listado actual.";
            return;
        }

        if (criteria is null)
        {
            Pending = TaskOperation.Link;
            Notice = "No se pudo consultar el listado actual de criterios.";
            NoticeError = coverageError;
            return;
        }

        var existing = criteria.Select(c => c.Id).ToHashSet();
        var expectedSaved = linkBaseline.Where(existing.Contains).ToHashSet();
        linkSelection.IntersectWith(existing);
        var fresh = await Api.GetTaskAcceptanceCriteriaAsync(ProjectId, ProposalId, taskId);
        if (fresh.Value is null || fresh.EntityTag is null)
        {
            Pending = TaskOperation.Link;
            Notice = "No se pudo consultar la selección actual de la tarea.";
            NoticeError = fresh.Error;
            return;
        }

        linkEntityTag = fresh.EntityTag;
        linkBaseline = [.. fresh.Value.AcceptanceCriterionIds];
        if (!linkBaseline.SetEquals(expectedSaved))
        {
            linkSavedVersion = [.. linkBaseline];
        }

        Notice = linkSelection.SetEquals(linkBaseline)
            ? "Alguno de los criterios elegidos ya no existe y la tarea ya tiene el resto de tu selección."
            : "Alguno de los criterios elegidos ya no existe. Se ha quitado de tu selección; revísala antes de guardarla.";
        if (linkSelection.SetEquals(linkBaseline))
        {
            ExitLinks();
        }
    }

    private void BeginSend(TaskOperation operation, TaskText? text, Guid? taskId)
    {
        Sending = true;
        ClearNotice();
        pendingOperation = operation;
        sentText = text;
        targetId = taskId;
        requestedOrder = null;
    }

    protected override async Task ClassifyConflictAsync(TaskOperation operation, SpecificationDto current)
    {
        var expectedStatus = operation is TaskOperation.Start or TaskOperation.Complete ? "approved" : "draft";
        if (current.Status != expectedStatus)
        {
            await LoadListAsync();
            MoveLocalTextToUnsaved();
            Notice = current.Status == "approved"
                ? "La especificación se aprobó y su planificación ya no se puede modificar."
                : "La especificación cambió de estado y las tareas se muestran según su estado actual.";
            return;
        }

        switch (operation)
        {
            case TaskOperation.Add:
                addError = DuplicateError();
                break;
            case TaskOperation.Edit:
                editError = DuplicateError();
                break;
            case TaskOperation.Start or TaskOperation.Complete:
                await LoadListAsync();
                Notice = "La tarea ya cambió de estado. Se muestra su estado actual.";
                break;
            case TaskOperation.Link:
                Pending = TaskOperation.Link;
                Notice = "No se pudieron guardar los vínculos. Consulta el estado actual antes de intentarlo de nuevo.";
                break;
            default:
                await LoadListAsync();
                Notice = "El listado de tareas cambió. Revisa el listado actual.";
                break;
        }
    }

    protected override Task HandleMissingAsync(TaskOperation operation) =>
        HandleMissingTaskAsync(operation is TaskOperation.Add or TaskOperation.Edit ? LocalText() : null);

    private async Task HandleMissingTaskAsync(string? localText)
    {
        if (await ReloadForMissingAsync(localText) is null) return;

        if (editingId is not null)
        {
            unsavedText = LocalText();
            ExitEdit();
        }

        await LoadListAsync();
        Notice = "La tarea ya no existe. Se muestra el listado actual.";
    }

    protected override async Task RecoverWithAsync(TaskOperation operation, SpecificationDto current)
    {
        var list = await Api.ListImplementationTasksAsync(ProjectId, ProposalId);
        if (list.Value is not { } currentTasks)
        {
            Notice = "No se pudo consultar el listado actual de tareas.";
            NoticeError = list.Error;
            return;
        }

        tasks = currentTasks;
        listEntityTag = list.EntityTag;
        listError = null;
        Pending = null;
        await LoadCoverageAsync();
        Notice = await ResolveRecoveryAsync(operation, currentTasks);

        if (current.Status != "draft" && operation is TaskOperation.Add or TaskOperation.Edit or TaskOperation.Delete or TaskOperation.Reorder or TaskOperation.Link)
        {
            MoveLocalTextToUnsaved();
            Notice = $"{Notice} La especificación ya no está en borrador y su planificación se muestra en modo de lectura.";
        }
    }

    private async Task<string> ResolveRecoveryAsync(TaskOperation operation, List<ImplementationTaskDto> current)
    {
        switch (operation)
        {
            case TaskOperation.Add:
                if (sentText is not null && current.Any(t => Matches(t, sentText)))
                {
                    newTitle = null;
                    newDescription = null;
                    return "La tarea se añadió correctamente.";
                }
                return "La tarea no se añadió. Tu texto sigue en los campos.";

            case TaskOperation.Edit:
                var target = current.FirstOrDefault(t => t.Id == targetId);
                if (target is null)
                {
                    unsavedText = LocalText();
                    ExitEdit();
                    return "La tarea ya no existe. Tu texto no se guardó y se muestra abajo.";
                }

                if (Matches(target, new TaskText(editTitle ?? "", Normalize(editDescription))))
                {
                    ExitEdit();
                    return "La tarea ya tiene el texto que enviaste.";
                }

                var fresh = await Api.GetImplementationTaskAsync(ProjectId, ProposalId, target.Id);
                if (fresh.Value is null || fresh.EntityTag is null)
                {
                    Pending = TaskOperation.Edit;
                    NoticeError = fresh.Error;
                    return "No se pudo consultar la versión actual de la tarea. Tu texto sigue en los campos.";
                }

                ReplaceTask(fresh.Value);
                editingId = target.Id;
                editEntityTag = fresh.EntityTag;
                savedVersion = new TaskText(fresh.Value.Title, fresh.Value.Description);
                return "Tu cambio no se guardó. Compara tu texto con la versión guardada y decide si guardas la tuya.";

            case TaskOperation.Delete:
                return current.Any(t => t.Id == targetId)
                    ? "La tarea no se eliminó. Puedes intentarlo de nuevo."
                    : "La tarea se eliminó correctamente.";

            case TaskOperation.Link:
                return await ResolveLinkRecoveryAsync(current);

            case TaskOperation.Start or TaskOperation.Complete:
                var expected = operation == TaskOperation.Start ? "in_progress" : "completed";
                return current.FirstOrDefault(t => t.Id == targetId)?.Status == expected
                    ? "El cambio de estado se aplicó correctamente."
                    : "El cambio de estado no se aplicó. Revisa el estado actual de la tarea.";

            default:
                return requestedOrder is not null && current.Select(t => t.Id).SequenceEqual(requestedOrder)
                    ? "El nuevo orden se guardó correctamente."
                    : "El orden no cambió. Revisa el listado actual.";
        }
    }

    private async Task<string> ResolveLinkRecoveryAsync(List<ImplementationTaskDto> current)
    {
        if (targetId is not { } id || current.All(t => t.Id != id))
        {
            unsavedLinks = linkingId is not null ? LinkText() : null;
            ExitLinks();
            return "La tarea ya no existe. Tu selección no se guardó.";
        }

        var fresh = await Api.GetTaskAcceptanceCriteriaAsync(ProjectId, ProposalId, id);
        if (fresh.Value is null || fresh.EntityTag is null)
        {
            Pending = TaskOperation.Link;
            NoticeError = fresh.Error;
            return "No se pudo consultar la selección actual de la tarea. Tu selección sigue marcada.";
        }

        var saved = fresh.Value.AcceptanceCriterionIds.ToHashSet();
        if (sentLinks is not null && saved.SetEquals(sentLinks))
        {
            ExitLinks();
            return "Los vínculos se guardaron correctamente.";
        }

        if (linkingId != id)
        {
            return "Los vínculos no se guardaron. Revisa los criterios actuales de la tarea.";
        }

        linkEntityTag = fresh.EntityTag;
        linkBaseline = saved;
        if (criteria is not null)
        {
            linkSelection.IntersectWith(criteria.Select(c => c.Id));
        }

        if (linkSelection.SetEquals(saved))
        {
            ExitLinks();
            return "La tarea ya tiene los criterios que elegiste.";
        }

        linkSavedVersion = [.. saved];
        return "Tu selección no se guardó. Compárala con la selección guardada y decide si guardas la tuya.";
    }

    private void ReplaceTask(ImplementationTaskDto current)
    {
        var index = tasks?.FindIndex(t => t.Id == current.Id) ?? -1;
        if (index >= 0)
        {
            tasks![index] = current;
        }
    }

    // The API trims titles, so a saved task matches the sent text after trimming.
    private static bool Matches(ImplementationTaskDto task, TaskText text) =>
        string.Equals(task.Title, text.Title.Trim(), StringComparison.Ordinal) &&
        string.Equals(task.Description, text.Description, StringComparison.Ordinal);

    // An empty description field means "no description"; any other text is sent unchanged.
    private static string? Normalize(string? description) =>
        string.IsNullOrEmpty(description) ? null : description;

    protected override string? ContextText() => LocalText() ?? LinkText();

    protected override string StaleSpecificationHint =>
        "No se pudo actualizar la especificación; consúltala de nuevo antes de editarla.";

    private string? LocalText()
    {
        var (title, description) = editingId is not null ? (editTitle, editDescription) : (newTitle, newDescription);
        if (string.IsNullOrEmpty(title) && string.IsNullOrEmpty(description)) return null;
        return string.IsNullOrEmpty(description) ? title : $"{title}\n\n{description}";
    }

    private void MoveLocalTextToUnsaved()
    {
        var local = LocalText();
        if (local is not null)
        {
            unsavedText = local;
        }

        if (linkingId is not null)
        {
            unsavedLinks = LinkText();
        }

        newTitle = null;
        newDescription = null;
        addError = null;
        confirmDeleteId = null;
        ExitEdit();
        ExitLinks();
    }

    // Numbers are only for display: they follow the order of the criteria section and are never sent.
    private List<int> CriterionNumbers(IEnumerable<Guid> ids)
    {
        var selected = ids.ToHashSet();
        return (criteria ?? []).Select((c, i) => (c.Id, Number: i + 1))
            .Where(c => selected.Contains(c.Id))
            .Select(c => c.Number)
            .ToList();
    }

    private List<Guid> OrderedSelection(IReadOnlySet<Guid> selection) =>
        (criteria ?? []).Select(c => c.Id).Where(selection.Contains).ToList();

    private List<int> UncoveredNumbers => criteria is null || links is null
        ? []
        : CriterionNumbers(criteria.Select(c => c.Id).Where(id => !links.Values.Any(l => l.Contains(id))));

    private string CoverageSummary => criteria switch
    {
        { Count: 0 } => "Todavía no hay criterios que cubrir.",
        _ when UncoveredNumbers is { Count: 0 } => "Todos los criterios tienen al menos una tarea.",
        _ when UncoveredNumbers is { Count: 1 } single => $"Criterio sin tarea: {single[0]}.",
        _ => $"Criterios sin tarea: {DisplayText.NumberList(UncoveredNumbers)}."
    };

    private string? CoverageText(Guid taskId)
    {
        if (criteria is null || links is null || !links.TryGetValue(taskId, out var linked)) return null;
        var numbers = CriterionNumbers(linked);
        return numbers.Count switch
        {
            0 => "No cubre ningún criterio.",
            1 => $"Cubre el criterio {numbers[0]}.",
            _ => $"Cubre los criterios {DisplayText.NumberList(numbers)}."
        };
    }

    private string SelectionText(IReadOnlySet<Guid> selection)
    {
        var numbers = CriterionNumbers(selection);
        return numbers.Count switch
        {
            0 => "ningún criterio",
            1 => $"criterio {numbers[0]}",
            _ => $"criterios {DisplayText.NumberList(numbers)}"
        };
    }

    private string? LinkText()
    {
        if (linkingId is not { } id) return null;
        var position = tasks?.FindIndex(t => t.Id == id) ?? -1;
        var title = position >= 0 ? tasks![position].Title : "la tarea";
        var chosen = (criteria ?? []).Select((c, i) => (c, i))
            .Where(c => linkSelection.Contains(c.c.Id))
            .Select(c => $"{c.i + 1}. {c.c.Content}")
            .ToList();
        return chosen.Count == 0
            ? $"{title}: sin criterios."
            : $"{title}:\n{string.Join("\n", chosen)}";
    }


    // Covers validation errors and the duplicate title shown next to the field.
    private static bool HasFieldError(ApiError? error) =>
        error is not null && (error.HasField("title") || error.HasField("description"));

    private static bool IsFieldValidation(ApiError? error) =>
        error is { StatusCode: 400 } && (error.HasField("title") || error.HasField("description"));

    private static ApiError DuplicateError() =>
        ApiError.Local(409, "Ya existe una tarea con ese título.", "title");

    private static string TitleMessage(ApiError error) => error.StatusCode == 409
        ? "Ya existe una tarea con ese título en esta especificación (sin distinguir mayúsculas)."
        : "Introduce un título de hasta 200 caracteres.";


}
